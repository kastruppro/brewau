#!/bin/bash -p
# brewau-upgrade: scheduled unattended update, run by launchd as _brewau.

set -u

BREWAU_LIBEXEC="/opt/brewau/libexec"
# shellcheck source=common.sh
source "${BREWAU_LIBEXEC}/common.sh"

LOCK_DIR="${BREWAU_STATE_DIR}/upgrade.lock"
LAST_RUN="${BREWAU_STATE_DIR}/last-run"

log() {
  echo "$(date '+%Y-%m-%d %H:%M:%S') $*"
}

brew_run() {
  (BREWAU_PASSTHROUGH_ENV="" brewau_exec_brew "$@")
}

write_state() {
  local status="$1" upgraded="$2"
  {
    echo "finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "status=${status}"
    echo "upgraded=${upgraded}"
  } >"${LAST_RUN}.tmp" && mv -f "${LAST_RUN}.tmp" "${LAST_RUN}"
}

filter_excluded() {
  local name word skip
  for name in "$@"; do
    skip=0
    for word in ${UPGRADE_EXCLUDE}; do
      [[ "${word}" == "${name}" ]] && skip=1
    done
    [[ ${skip} -eq 0 ]] && echo "${name}"
  done
}

main() {
  [[ "$(id -un)" == "${BREWAU_USER}" ]] || brewau_die "brewau-upgrade must run as ${BREWAU_USER}"
  brewau_load_config

  if [[ "${AUTO_UPGRADE}" != "1" ]]; then
    log "AUTO_UPGRADE is disabled; nothing to do"
    exit 0
  fi

  if ! mkdir "${LOCK_DIR}" 2>/dev/null; then
    log "another upgrade is running; exiting"
    exit 0
  fi
  trap 'rmdir "${LOCK_DIR}" 2>/dev/null' EXIT

  local status="ok" greedy="" formulae casks
  [[ "${UPGRADE_GREEDY}" == "1" ]] && greedy="--greedy"

  log "brew update"
  brew_run update || status="update-failed"

  # shellcheck disable=SC2046
  formulae="$(filter_excluded $(brew_run outdated --formula --quiet))"
  # shellcheck disable=SC2046
  casks="$(filter_excluded $(brew_run outdated --cask --quiet ${greedy}))"

  if [[ -n "${formulae}" ]]; then
    log "upgrading formulae: $(echo ${formulae})"
    # shellcheck disable=SC2086
    brew_run upgrade --formula ${formulae} || status="upgrade-failed"
  fi
  if [[ -n "${casks}" ]]; then
    log "upgrading casks: $(echo ${casks})"
    # shellcheck disable=SC2086
    brew_run upgrade --cask ${greedy} ${casks} || status="upgrade-failed"
  fi
  [[ -z "${formulae}${casks}" ]] && log "everything is up to date"

  log "brew cleanup"
  brew_run cleanup --prune=30 || true

  write_state "${status}" "$(echo ${formulae} ${casks})"
  log "done (${status})"
  [[ "${status}" == "ok" ]]
}

main "$@"
