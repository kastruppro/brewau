#!/bin/bash -p
# brewau-upgrade: scheduled unattended update, run by launchd as _brewau.
#
# brewau-agent serializes scheduled and manual work with an OS file lock.

set -u

# Never trust the caller's PATH: sudo passes it through, so a program planted
# in it would run with this script's privileges.
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

BREWAU_LIBEXEC="/opt/brewau/libexec"
# shellcheck source=common.sh
source "${BREWAU_LIBEXEC}/common.sh"
BREWAU_PASSTHROUGH_ENV="HOMEBREW_NO_AUTO_UPDATE=1"

LAST_RUN="${BREWAU_STATE_DIR}/last-run"
# Asks the root self-update job (brewau-agent self-update) to update brewau
# itself once this run is over: its package cannot install while this job runs.
SELF_UPDATE_DUE="${BREWAU_STATE_DIR}/self-update-due"
# Formulae this job pinned because of UPGRADE_EXCLUDE, so it only ever unpins
# its own pins and leaves pins made by users alone.
EXCLUDE_PINS="${BREWAU_STATE_DIR}/exclude-pins"

log() {
  echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [${BREWAU_JOB:-upgrade}] $*"
}

log_output() {
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    log "brew: ${line}"
  done
}

brew_run() {
  (brewau_exec_brew "$@")
}

# last-result.json: UTC finished, job, status, reason, and upgraded/failed/blocked
# arrays of {name, kind, version, reason}; blocked adds installed for retry matching.
# errors is an append-only array of {stage, reason} for this run. The first error
# determines status=<stage>-failed/reason. Errors outrank blocks, then pending
# protection. Only an App Management failure from Homebrew creates a block.
result_init() {
  local file="${BREWAU_STATE_DIR}/blocked-casks.json" blocked count i field valid=1
  if [[ -e "${BREWAU_STATE_DIR}/clear-blocked" ]]; then
    rm -f "${file}" "${BREWAU_STATE_DIR}/clear-blocked" || return 1
  fi
  RESULT="${BREWAU_STATE_DIR}/last-result.json.tmp"
  printf '{"upgraded":[],"failed":[],"blocked":[],"unprotected":[],"errors":[]}' >"${RESULT}" || return 1
  if [[ -r "${file}" ]]; then
    blocked="$(plutil -extract blocked json -o - "${file}" 2>/dev/null)" || valid=0
    count="$(plutil -extract blocked raw -o - "${file}" 2>/dev/null)" || valid=0
    [[ "${blocked}" == \[* && "${count}" =~ ^[0-9]+$ ]] || valid=0
    if [[ ${valid} == 1 ]]; then
      for ((i=0; i<count; i++)); do
        for field in name kind version reason installed; do
          plutil -extract "blocked.${i}.${field}" raw -o - "${file}" >/dev/null 2>&1 || valid=0
        done
      done
    fi
    if [[ ${valid} == 1 ]]; then
      plutil -replace blocked -json "${blocked}" "${RESULT}" || return 1
    else
      log "invalid blocked-casks.json; resetting blocked casks"
      rm -f "${file}" || return 1
    fi
  fi
}

result_item() {
  local array="$1" name="$2" kind="$3" version="$4" reason="$5" installed="${6:-}" item count
  item='{"name":""}'
  item="$(plutil -replace name -string "${name}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert kind -string "${kind}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert version -string "${version}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert reason -string "${reason}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert installed -string "${installed}" -o - - <<<"${item}")" || return 1
  if [[ "${array}" == unprotected ]]; then
    item="$(plutil -insert protection -string "$7" -o - - <<<"${item}")" || return 1
    item="$(plutil -insert deferred -bool "$8" -o - - <<<"${item}")" || return 1
  fi
  item="$(plutil -convert json -o - - <<<"${item}")" || return 1
  count="$(plutil -extract "${array}" raw -o - "${RESULT}")" || return 1
  plutil -insert "${array}.${count}" -json "${item}" "${RESULT}"
}

result_error() {
  local stage="$1" reason="$2" item count
  item="$(plutil -replace stage -string "${stage}" -o - - <<<'{"stage":""}')" || return 1
  item="$(plutil -insert reason -string "${reason}" -o - - <<<"${item}")" || return 1
  count="$(plutil -extract errors raw -o - "${RESULT}")" || return 1
  plutil -insert "errors.${count}" -json "${item}" "${RESULT}"
}

# Set the caller's status/reason from the complete result, never from the last failure.
result_status() {
  local count stage
  status="$1" reason="$2"
  count="$(plutil -extract errors raw -o - "${RESULT}")" || return 1
  if [[ ${count} -gt 0 ]]; then
    stage="$(plutil -extract errors.0.stage raw -o - "${RESULT}")" || return 1
    status="${stage}-failed"
    reason="$(plutil -extract errors.0.reason raw -o - "${RESULT}")" || return 1
  else
    count="$(plutil -extract blocked raw -o - "${RESULT}")" || return 1
    if [[ ${count} -gt 0 ]]; then
      status=blocked
      reason="app-management"
    else
      count="$(plutil -extract unprotected raw -o - "${RESULT}")" || return 1
      if [[ ${count} -gt 0 ]]; then status=ok; reason=unprotected; fi
    fi
  fi
}

write_state() {
  local status="$1" upgraded="$2" reason="${3:-brew-error}" finished
  finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  result_status "${status}" "${reason}" || return 1
  {
    echo "finished=${finished}"
    echo "status=${status}"
    echo "upgraded=${upgraded}"
  } >"${LAST_RUN}.tmp" && mv -f "${LAST_RUN}.tmp" "${LAST_RUN}"
  plutil -insert finished -string "${finished}" "${RESULT}" &&
    plutil -insert job -string "${BREWAU_JOB:-upgrade}" "${RESULT}" &&
    plutil -insert status -string "${status}" "${RESULT}" &&
    plutil -insert reason -string "${reason}" "${RESULT}" &&
    plutil -convert json "${RESULT}" &&
    mv -f "${RESULT}" "${RESULT_DEST:-${BREWAU_STATE_DIR}/last-result.json}"
}

# Only connection failures mean offline; TLS/HTTP problems remain brew errors.
network_available() {
  local rc=0
  /usr/bin/curl -sS -I --connect-timeout 5 --max-time 10 -o /dev/null \
    https://formulae.brew.sh/api/formula.json 2>/dev/null || rc=$?
  case "${rc}" in 6 | 7 | 28) return 1 ;; esac
  return 0
}

# A legacy protection row with no saved Homebrew refusal gets one guarded retry.
legacy_protection_block() {
  local file="$1" index="$2" name="$3" version="$4" count i failed_name
  plutil -extract "blocked.${index}.protection" raw -expect string -o /dev/null "${file}" 2>/dev/null || return 1
  count="$(plutil -extract failed raw -expect array -o - "${file}" 2>/dev/null)" || count=0
  for ((i=0; i<count; i++)); do
    failed_name="$(plutil -extract "failed.${i}.name" raw -o - "${file}" 2>/dev/null)" || continue
    if [[ "${failed_name##*/}" == "${name##*/}" &&
      "$(plutil -extract "failed.${i}.version" raw -o - "${file}" 2>/dev/null)" == "${version}" &&
      "$(plutil -extract "failed.${i}.reason" raw -o - "${file}" 2>/dev/null)" == app-management ]]; then
      return 1
    fi
  done
  return 0
}

package_field() {
  local kind="$1" name="$2" field="$3" count i found
  count="$(plutil -extract "${kind}" raw -o - - <<<"${json}")" || return 1
  for ((i=0; i<count; i++)); do
    found="$(plutil -extract "${kind}.${i}.name" raw -o - - <<<"${json}")" || continue
    [[ "${found##*/}" == "${name##*/}" ]] || continue
    if [[ "${field}" == current_version ]]; then
      plutil -extract "${kind}.${i}.${field}" raw -o - - <<<"${json}"
    else
      plutil -extract "${kind}.${i}.${field}" json -o - - <<<"${json}"
    fi
    return
  done
  return 1
}

# True if formula or cask $1 is in UPGRADE_EXCLUDE. Either may name it with or
# without its tap: Homebrew prints tap packages as user/repo/name.
excluded() {
  local word
  for word in ${UPGRADE_EXCLUDE}; do
    [[ "${word##*/}" == "${1##*/}" ]] && return 0
  done
  return 1
}

# Prints the arguments that are not excluded.
not_excluded() {
  local name
  for name in "$@"; do
    excluded "${name}" || echo "${name}"
  done
}

# Prints the outdated, unpinned names of kind $1 (formulae or casks) from the
# `brew outdated --json=v2` output in $2. Homebrew refuses to upgrade a pinned
# package named on the command line, so pins must be left out here.
outdated_names() {
  local kind="$1" json="$2" count i
  count="$(plutil -extract "${kind}" raw -o - - <<<"${json}" 2>/dev/null)" || return 1
  [[ "${count}" =~ ^[0-9]+$ ]] || return 1
  for ((i = 0; i < count; i++)); do
    [[ "$(plutil -extract "${kind}.${i}.pinned" raw -o - - <<<"${json}" 2>/dev/null)" == "true" ]] && continue
    plutil -extract "${kind}.${i}.name" raw -o - - <<<"${json}" 2>/dev/null || return 1
  done
}

# `brew upgrade` also upgrades outdated dependencies of what it upgrades, so
# leaving a formula off the command line does not exclude it. A pin does.
# Reconciles against the actual pins every run, so a pin that disappeared
# (brew unpin, reinstall) is put back. Fails if the pins cannot be verified.
# Pins and the installed list use plain names, so UPGRADE_EXCLUDE entries are
# reduced to theirs.
sync_exclude_pins() {
  local installed pinned previous="" word name kept="" result=0
  installed="$(brew_run list --formula -1)" || return 1
  pinned="$(brew_run list --pinned --formula)" || return 1
  [[ -r "${EXCLUDE_PINS}" ]] && previous="$(cat "${EXCLUDE_PINS}")"

  for name in ${previous}; do
    excluded "${name}" && continue
    brewau_in_words "${name}" "${pinned}" || continue
    log "unpinning ${name} (no longer in UPGRADE_EXCLUDE)"
    brew_run unpin "${name}" || { kept="${kept} ${name}"; result=1; }
  done
  for word in ${UPGRADE_EXCLUDE}; do
    name="${word##*/}"
    brewau_in_words "${name}" "${installed}" || continue
    brewau_in_words "${name}" "${kept}" && continue
    if brewau_in_words "${name}" "${pinned}"; then
      # Keep owning our own pins; a pin someone else made is respected but
      # not taken over, so it is never unpinned by this job.
      brewau_in_words "${name}" "${previous}" && kept="${kept} ${name}"
      continue
    fi
    log "pinning ${name} (UPGRADE_EXCLUDE)"
    if brew_run pin "${name}"; then
      kept="${kept} ${name}"
    else
      result=1
    fi
  done
  echo "${kept# }" >"${EXCLUDE_PINS}"
  return "${result}"
}

# A system service keeps running the old binary after its formula is
# upgraded, so restart the ones that are loaded. Fails if one did not restart.
restart_system_services() {
  local name result=0
  for name in "$@"; do
    name="${name##*/}"
    brewau_service_allowed "${name}" || continue
    brewau_service_loaded system "${name}" || continue
    log "restarting system service ${name}"
    if ! (brewau_exec_brew_as_root services restart "${name}"); then
      log "could not restart ${name}"
      result=1
    fi
    brewau_release_service_keg "${name}"
  done
  return "${result}"
}

# Homebrew leaves temp files behind when a cask fails; keep the directory small.
clean_tmp() {
  find "${BREWAU_TMP}" -mindepth 1 -maxdepth 1 -type d -name 'cask-*' -user "${BREWAU_USER}" -mtime +1 -exec rm -rf {} + 2>/dev/null
  return 0
}

# Decode Shellwords.shelljoin as data, retaining argument boundaries without a shell.
shellwords_has_app() {
  local command="$1" app="$2" arg="" quote="" char escaped=0 found=0 i
  for ((i=0; i<${#command}; i++)); do
    char="${command:i:1}"
    if [[ ${escaped} == 1 ]]; then
      arg+="${char}"; escaped=0
    elif [[ "${quote}" == "'" ]]; then
      if [[ "${char}" == "'" ]]; then quote=""; else arg+="${char}"; fi
    elif [[ "${char}" == \\ ]]; then
      escaped=1
    elif [[ -n "${quote}" ]]; then
      if [[ "${char}" == "${quote}" ]]; then quote=""; else arg+="${char}"; fi
    elif [[ "${char}" == "'" || "${char}" == '"' ]]; then
      quote="${char}"
    elif [[ "${char}" == ' ' ]]; then
      [[ "${arg}" == "${app}" || "${arg}" == "${app}/"* ]] && found=1
      arg=""
    else
      arg+="${char}"
    fi
  done
  [[ -z "${quote}" && ${escaped} == 0 ]] || return 1
  [[ "${arg}" == "${app}" || "${arg}" == "${app}/"* ]] && found=1
  [[ ${found} == 1 ]]
}

# Only artifact errors for this cask's validated app target imply App Management.
cask_app_management_error() {
  local name="$1" output="$2" catalog token app line diagnostics="" explicit=0 wrappers="" wrapper command tool explained
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ "${line}" != *"Rolling back"* && "${line}" != *"rollback"* ]] || return 1
    case "${line}" in
      cp:* | mv:* | ditto:* | chmod:* | chown:* | chflags:*) diagnostics+="${line}"$'\n' ;;
      *"App Management permissions"*) explicit=1 ;;
      Error:* | *'Error: '*)
        [[ "${line}" == *'Failure while executing;'* ]] || return 1
        wrappers+="${line}"$'\n' ;;
      Warning:* | '==>'* | '') ;;
      *:*) return 1 ;;
    esac
  done <<<"${output}"
  while IFS= read -r wrapper; do
    [[ -n "${wrapper}" ]] || continue
    command="${wrapper#*\`}"
    if [[ "${command}" == '/usr/bin/sudo '* ]]; then
      [[ "${command}" == *' -- '* ]] || return 1
      command="${command#* -- }"
    fi
    command="${command%% *}"
    case "${command}" in /bin/cp | /bin/mv | /usr/bin/ditto | /bin/chmod | /usr/sbin/chown | /usr/bin/chflags) ;; *) return 1 ;; esac
    tool="${command##*/}"
    awk -F: -v tool="${tool}" '$1 == tool {found=1} END {exit !found}' <<<"${diagnostics}" || return 1
  done <<<"${wrappers}"
  if [[ -z "${diagnostics}" ]]; then [[ ${explicit} == 1 ]]; return; fi
  catalog="$(mktemp "${BREWAU_TMP}/cask-error.XXXXXX")" || return 1
  if ! brew_run info --json=v2 --installed --cask >"${catalog}"; then rm -f "${catalog}"; return 1; fi
  while IFS=$'\t' read -r token app; do
    [[ "${token}" == "${name##*/}" ]] || continue
    if brewau_app_eperm "${app}" "${diagnostics}"; then
      explained=1
      while IFS= read -r wrapper; do
        [[ -n "${wrapper}" ]] || continue
        command="${wrapper#*\`}"; command="${command%\` exited with *}"
        shellwords_has_app "${command}" "${app}" || { explained=0; break; }
        [[ ${explained} == 1 ]] || break
      done <<<"${wrappers}"
      if [[ ${explained} == 1 ]]; then rm -f "${catalog}"; return 0; fi
    fi
  done < <(brewau_cask_app_targets "${catalog}")
  rm -f "${catalog}"
  return 1
}

# Up-to-date apps still need protection; outdated JSON has no row for them.
protection_versions() {
  local token="$1" catalog count i found version installed
  if [[ "${protection_after:-0}" == 0 ]] && version="$(package_field casks "${token}" current_version)" &&
    installed="$(package_field casks "${token}" installed_versions)"; then
    printf '%s\t%s\n' "${version}" "${installed}"
    return
  fi
  catalog="$(brew_run info --json=v2 --installed --cask)" || return 1
  count="$(plutil -extract casks raw -o - - <<<"${catalog}")" || return 1
  [[ "${count}" =~ ^[0-9]+$ ]] || return 1
  for ((i=0; i<count; i++)); do
    found="$(plutil -extract "casks.${i}.token" raw -o - - <<<"${catalog}")" || continue
    [[ "${found}" == "${token}" ]] || continue
    version="$(plutil -extract "casks.${i}.version" raw -o - - <<<"${catalog}")" || return 1
    installed="$(plutil -extract "casks.${i}.installed" raw -expect string -o - - <<<"${catalog}")" || return 1
    installed="$(plutil -insert installed.0 -string "${installed}" -o - - <<<'{"installed":[]}')" || return 1
    installed="$(plutil -extract installed json -o - - <<<"${installed}")" || return 1
    printf '%s\t%s\n' "${version}" "${installed}"
    return
  done
  return 1
}

# Only direct app bundles in /Applications are eligible for the privileged retry.
pending_app_path() {
  [[ "$1" == "${BREWAU_APPDIR}"/*.app && "${1%/*}" == "${BREWAU_APPDIR}" &&
     "$1" != *..* && "$1" != *[[:cntrl:]]* ]]
}

pending_count() {
  plutil -extract items raw -expect array -o - - <<<"$1"
}

# Keep the first observation of an unresolved token/app/operation.
pending_item() {
  local old="$1" token="$2" version="$3" app="$4" operation="$5" since="" count i item
  count="$(pending_count "${old}" 2>/dev/null)" || count=0
  for ((i=0; i<count; i++)); do
    [[ "$(plutil -extract "items.${i}.token" raw -o - - <<<"${old}" 2>/dev/null)" == "${token}" &&
       "$(plutil -extract "items.${i}.app" raw -o - - <<<"${old}" 2>/dev/null)" == "${app}" &&
       "$(plutil -extract "items.${i}.operation" raw -o - - <<<"${old}" 2>/dev/null)" == "${operation}" ]] || continue
    since="$(plutil -extract "items.${i}.since" raw -expect string -o - - <<<"${old}" 2>/dev/null)" || since=""
    break
  done
  [[ -n "${since}" ]] || since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  item="$(plutil -replace token -string "${token}" -o - - <<<'{"token":""}')" || return 1
  item="$(plutil -insert version -string "${version}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert app -string "${app}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert operation -string "${operation}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert since -string "${since}" -o - - <<<"${item}")" || return 1
  plutil -convert json -o - - <<<"${item}"
}

protect_for_upgrade() {
  local report rc=0 token cause app operation version installed metadata deferred item count
  local file="${BREWAU_STATE_DIR}/pending-protection.json" old='{"items":[]}' next='{"items":[]}'
  report="$(brewau_protect_installed_apps --report-reasons '' /usr/bin/sudo -n)" || rc=$?
  if [[ ${rc} == 2 || ( ${rc} != 0 && -z "${report}" ) ]]; then
    result_error protect protect-failed || return 1
    return 2
  fi
  [[ ! -L "${file}" && ( ! -e "${file}" || -f "${file}" ) ]] || return 1
  [[ ! -f "${file}" ]] || old="$(cat "${file}")" || return 1
  plutil -replace unprotected -json '[]' "${RESULT}" || return 1
  while IFS=$'\t' read -r token cause app operation; do
    [[ -n "${token}" ]] || continue
    if [[ "${cause}" == app-management && ( "${operation}" == pin || "${operation}" == lock ) ]] &&
      pending_app_path "${app}" && metadata="$(protection_versions "${token}")"; then
      IFS=$'\t' read -r version installed <<<"${metadata}"
      deferred=NO
      if [[ ${protection_after} == 0 ]]; then deferred_protection="${deferred_protection} ${token}"; fi
      if brewau_in_words "${token}" "${deferred_protection}" &&
        version="$(package_field casks "${token}" current_version)"; then
        deferred=YES
      else
        version="$(plutil -extract 0 raw -expect string -o - - <<<"${installed}")" || return 1
      fi
      item="$(pending_item "${old}" "${token}" "${version}" "${app}" "${operation}")" || return 1
      count="$(pending_count "${next}")" || return 1
      next="$(plutil -insert "items.${count}" -json "${item}" -o - - <<<"${next}")" || return 1
      result_item unprotected "${token}" cask "${version}" app-management "${installed}" "${app}"$'\t'"${operation}" "${deferred}" || return 1
    elif ! brewau_in_words "${token}" "${failed_protection}"; then
      failed_protection="${failed_protection} ${token}"
      result_error protect protect-failed || return 1
    fi
  done <<<"${report}"
  if [[ -f "${file}" || "${next}" != '{"items":[]}' ]]; then
    next="$(plutil -convert json -o - - <<<"${next}")" || return 1
    brewau_write_state "${file}" "${next}" || return 1
  fi
}

run_upgrade() {
  local status="ok" greedy="" formulae="" casks="" output json name
  local upgraded="" reason=ok version installed kind item_reason package_greedy enumeration_ok=1
  result_init || return 1
  if ! network_available; then
    log "offline, skipped"
    log "done (offline)"
    write_state skipped "" offline
    clean_tmp
    return 0
  fi
  [[ "${UPGRADE_GREEDY}" == "1" ]] && greedy="--greedy"

  log "brew update"
  if ! brew_run update; then
    result_error update brew-error || return 1
    write_state "update-failed" ""
    clean_tmp
    log "done (update-failed)"
    return 1
  fi

  # Without verified pins an excluded formula could be upgraded as a
  # dependency, so formulae are skipped rather than risk it.
  local formulae_ok=1
  if ! sync_exclude_pins; then
    log "could not verify UPGRADE_EXCLUDE pins"
    result_error pin brew-error || return 1
    [[ -n "${UPGRADE_EXCLUDE}" ]] && formulae_ok=0
  fi

  # Check each command's exit status: inside a substitution a failure would
  # otherwise look like "nothing is outdated".
  # shellcheck disable=SC2086
  json="$(brew_run outdated --json=v2 ${greedy})" || enumeration_ok=0
  local blocked_tokens="" deferred_protection="" failed_protection="" protect_rc=0 protection_after=0
  if [[ ${enumeration_ok} == 1 ]]; then
    plutil -replace blocked -json '[]' "${RESULT}" || return 1
    local block_file="${BREWAU_STATE_DIR}/blocked-casks.json" block_count block_i metadata
    block_count="$(plutil -extract blocked raw -expect array -o - "${block_file}" 2>/dev/null)" || block_count=0
    for ((block_i=0; block_i<block_count; block_i++)); do
      name="$(plutil -extract "blocked.${block_i}.name" raw -o - "${block_file}")" || continue
      metadata="$(protection_versions "${name##*/}")" || continue
      IFS=$'\t' read -r version installed <<<"${metadata}"
      if [[ "$(plutil -extract "blocked.${block_i}.version" raw -o - "${block_file}")" == "${version}" &&
        "$(plutil -extract "blocked.${block_i}.installed" raw -o - "${block_file}")" == "${installed}" ]] &&
        ! legacy_protection_block "${block_file}" "${block_i}" "${name}" "${version}"; then
        blocked_tokens="${blocked_tokens} ${name##*/}"
        result_item blocked "${name}" cask "${version}" app-management "${installed}" || return 1
      fi
    done
  fi
  protect_for_upgrade || { protect_rc=$?; [[ ${protect_rc} == 2 ]] || return 1; }
  if [[ ${enumeration_ok} == 1 ]]; then
    if [[ ${formulae_ok} -eq 1 ]]; then
      if output="$(outdated_names formulae "${json}")"; then
        # shellcheck disable=SC2086
        formulae="$(not_excluded ${output})"
      else
        log "could not list outdated formulae"
        result_error outdated brew-error || return 1
        enumeration_ok=0
      fi
    fi
    if output="$(outdated_names casks "${json}")"; then
      # shellcheck disable=SC2086
      for name in $(not_excluded ${output}); do
        # brewau updates itself after this run (SELF_UPDATE_DUE).
        [[ "${name##*/}" == "brewau" ]] && continue
        brewau_in_words "${name##*/}" "${blocked_tokens}" && continue
        if [[ ${protect_rc} -eq 2 ]] || brewau_in_words "${name##*/}" "${failed_protection}"; then
          version="$(package_field casks "${name}" current_version)" || version="unknown"
          result_item failed "${name}" cask "${version}" protect-failed || return 1
        elif ! brewau_in_words "${name##*/}" "${deferred_protection}"; then
          casks="${casks} ${name}"
        fi
      done
    else
      log "could not list outdated casks"
      result_error outdated brew-error || return 1
      enumeration_ok=0
    fi
  else
    log "could not list outdated packages"
    result_error outdated brew-error || return 1
    enumeration_ok=0
  fi

  # Keep successful packages when another package fails in the same run.
  for kind in formula cask; do
    if [[ "${kind}" == formula ]]; then
      output="${formulae}"
      package_greedy=""
    else
      output="${casks}"
      package_greedy="${greedy}"
    fi
    for name in ${output}; do
      if [[ "${kind}" == formula ]]; then
        version="$(package_field formulae "${name}" current_version)" || version='null'
        installed=""
      else
        version="$(package_field casks "${name}" current_version)" || version='null'
        installed="$(package_field casks "${name}" installed_versions)" || installed='null'

      fi
      log "upgrading ${kind}: ${name}"
      # shellcheck disable=SC2086
      if output="$(brew_run upgrade --${kind} ${package_greedy} "${name}" 2>&1)"; then
        log_output <<<"${output}"
        upgraded="${upgraded:+${upgraded} }${name}"
        result_item upgraded "${name}" "${kind}" "${version}" ok || return 1
        if [[ "${kind}" == formula ]]; then
          restart_system_services "${name}" || { result_error restart brew-error || return 1; }
        fi
      else
        log_output <<<"${output}"
        item_reason=brew-error
        if [[ "${kind}" == cask ]] && cask_app_management_error "${name}" "${output}"; then
          item_reason="app-management"
          result_item blocked "${name}" cask "${version}" "${item_reason}" "${installed}" || return 1
          log "${name}: Homebrew upgrade blocked by macOS App Management"
        fi
        result_item failed "${name}" "${kind}" "${version}" "${item_reason}" || return 1
        if [[ "${item_reason}" != app-management ]]; then
          result_error upgrade "${item_reason}" || return 1
        fi
      fi
    done
  done
  if [[ -n "${casks}" ]]; then protection_after=1; protect_for_upgrade || { [[ $? == 2 ]] || return 1; }; fi
  # Replace the block list only after a successful outdated query, so offline
  # or failed enumeration cannot accidentally clear a block.
  if [[ ${enumeration_ok} == 1 ]]; then
    local blocked
    blocked="$(plutil -extract blocked json -o - "${RESULT}")" || return 1
    brewau_write_state "${BREWAU_STATE_DIR}/blocked-casks.json" "{\"blocked\":${blocked}}" || return 1
  fi
  result_status ok ok || return 1
  [[ -z "${formulae}${casks}" && "${reason}" == ok ]] && log "everything is up to date"

  log "brew cleanup"
  brew_run cleanup "--prune=${CLEANUP_PRUNE_DAYS}" || { result_error cleanup brew-error || return 1; }
  clean_tmp

  if ! refresh_snapshot; then
    log "could not refresh the GUI snapshot"
    result_error snapshot brew-error || return 1
  fi

  result_status ok ok || return 1
  write_state "${status}" "${upgraded}" "${reason}" || return 1
  touch "${SELF_UPDATE_DUE}" || log "could not ask for a brewau self-update"
  log "done (${status})"
  [[ "${status}" == "ok" || "${status}" == blocked ]]
}

# Publish complete JSON files atomically; a failed scan leaves the last good data intact.
refresh_snapshot() {
  local greedy="" json catalog version
  [[ "${UPGRADE_GREEDY}" == "1" ]] && greedy="--greedy"
  # shellcheck disable=SC2086
  json="$(brew_run outdated --json=v2 ${greedy})" || return 1
  plutil -extract formulae raw -o - - <<<"${json}" >/dev/null 2>&1 || return 1
  plutil -extract casks raw -o - - <<<"${json}" >/dev/null 2>&1 || return 1
  catalog="$(brew_run info --json=v2 --installed --cask)" || return 1
  plutil -extract casks raw -o - - <<<"${catalog}" >/dev/null 2>&1 || return 1
  printf '%s\n' "${catalog}" >"${BREWAU_STATE_DIR}/catalog.json.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/catalog.json.tmp" "${BREWAU_STATE_DIR}/catalog.json" || return 1
  printf '%s\n' "${json}" >"${BREWAU_STATE_DIR}/updates.json.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/updates.json.tmp" "${BREWAU_STATE_DIR}/updates.json" || return 1
  version="$(brew_run --version)" || return 1
  printf '%s\n' "${version%%$'\n'*}" >"${BREWAU_STATE_DIR}/homebrew-version.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/homebrew-version.tmp" "${BREWAU_STATE_DIR}/homebrew-version"
}

run_scan() {
  local BREWAU_JOB="scan" status=ok reason=ok
  local LAST_RUN="${BREWAU_STATE_DIR}/last-scan" RESULT
  local RESULT_DEST="${BREWAU_STATE_DIR}/last-scan-result.json"
  result_init || return 1
  if ! network_available; then
    log "offline, skipped"
    log "done (offline)"
    write_state skipped "" offline
    clean_tmp
    return 0
  fi
  if [[ "${UPDATE_HOMEBREW}" == "1" ]]; then
    log "brew update (scan)"
    if ! brew_run update; then
      log "done (update-failed)"
      result_error update brew-error || return 1
      write_state update-failed "" brew-error
      clean_tmp
      return 1
    fi
  fi
  refresh_snapshot || { result_error snapshot brew-error || return 1; }
  result_status ok ok || return 1
  write_state "${status}" "" "${reason}" || return 1
  clean_tmp
  log "done (${status})"
  [[ "${status}" == ok || "${status}" == blocked ]]
}

# The agent holds the operation lock. Read mutable state and the Homebrew catalog
# as _brewau, with only the existing protection operations running as root.
protect_pending() (
  local file="${BREWAU_STATE_DIR}/pending-protection.json" catalog apps original pending count i token app operation report
  local failed=0 denied=0 BREWAU_JOB=protect cask_count installed_tokens=""
  local token_pattern='^[a-zA-Z0-9][a-zA-Z0-9._+@-]*$'
  # A lock may move the bundle into staging before copying it back.
  trap '' INT TERM HUP QUIT PIPE TSTP
  if [[ -L "${file}" || ( -e "${file}" && ! -f "${file}" ) ]]; then
    log "failed (invalid pending protection file)"
    return 1
  fi
  [[ -f "${file}" ]] || return 0
  if ! original="$(cat "${file}")" || ! count="$(pending_count "${original}" 2>/dev/null)"; then
    log "failed (invalid pending protection data)"
    return 1
  fi
  [[ ${count} -gt 0 ]] || return 0
  catalog="$(mktemp "${BREWAU_TMP}/protect-catalog.XXXXXX")" || return 1
  trap 'rm -f "${catalog}"' EXIT
  if ! brewau_cache_forbidden_taps || ! brew_run info --json=v2 --installed --cask >"${catalog}" ||
    ! cask_count="$(plutil -extract casks raw -expect array -o - "${catalog}")"; then
    log "failed (could not list installed casks)"
    return 1
  fi
  for ((i=0; i<cask_count; i++)); do
    token="$(plutil -extract "casks.${i}.token" raw -expect string -o - "${catalog}" 2>/dev/null)" || token=""
    if [[ ! "${token}" =~ ${token_pattern} ]]; then
      log "failed (invalid installed cask catalog)"
      return 1
    fi
    installed_tokens+=${token}$'\n'
  done
  apps="$(brewau_cask_app_targets "${catalog}")"
  pending="${original}"
  for ((i=count-1; i>=0; i--)); do
    token="$(plutil -extract "items.${i}.token" raw -expect string -o - - <<<"${original}" 2>/dev/null)" || token=""
    app="$(plutil -extract "items.${i}.app" raw -expect string -o - - <<<"${original}" 2>/dev/null)" || app=""
    operation="$(plutil -extract "items.${i}.operation" raw -expect string -o - - <<<"${original}" 2>/dev/null)" || operation=""
    if [[ ! "${token}" =~ ${token_pattern} ]]; then
      log "failed (invalid cask token)"
      failed=1
      continue
    fi
    if ! grep -Fxq -- "${token}" <<<"${installed_tokens}"; then
      pending="$(plutil -remove "items.${i}" -o - - <<<"${pending}")" || return 1
      log "${token}: removed from pending protection (cask uninstalled)"
      continue
    fi
    if ! pending_app_path "${app}" ||
      [[ ( "${operation}" != lock && "${operation}" != pin ) || ! -d "${app}" || -L "${app}" ]] ||
      ! grep -Fxq -- "${token}"$'\t'"${app}" <<<"${apps}"; then
      log "${token}: failed (pending app does not match an installed cask artifact)"
      failed=1
      continue
    fi
    if report="$(brewau_protect_apps "${catalog}" --report-reasons '' --only-app "${token}" "${app}" /usr/bin/sudo -n 2>/dev/null)"; then
      pending="$(plutil -remove "items.${i}" -o - - <<<"${pending}")" || return 1
      log "${token}: protected"
    elif [[ "${report}" == "${token}"$'\tapp-management\t'"${app}"$'\t'lock ||
            "${report}" == "${token}"$'\tapp-management\t'"${app}"$'\t'pin ]]; then
      log "${token}: still refused by macOS App Management"
      denied=3
    else
      log "${token}: failed (trust or protection check)"
      failed=1
    fi
  done
  if [[ "${pending}" != "${original}" ]]; then
    pending="$(plutil -convert json -o - - <<<"${pending}")" || return 1
    brewau_write_state "${file}" "${pending}" || return 1
  fi
  [[ ${failed} == 0 ]] || return 1
  return "${denied}"
)

# With AUTO_UPGRADE=0 the LaunchDaemon has no schedule, so the job only runs
# when started with `brewau run`.
main() {
  if [[ "${1:-}" == protect-pending ]]; then
    [[ $# == 1 ]] || return 1
    trap '' INT TERM HUP QUIT PIPE TSTP
    if [[ "$(id -u)" == 0 ]]; then
      exec /usr/bin/sudo -n -u "${BREWAU_USER}" -- "${BREWAU_LIBEXEC}/brewau-upgrade" protect-pending
    fi
  fi
  [[ "$(id -un)" == "${BREWAU_USER}" ]] || brewau_die "brewau-upgrade must run as ${BREWAU_USER}"
  brewau_load_config
  if [[ "${1:-}" == protect-pending ]]; then
    protect_pending >>"${BREWAU_LOG_DIR}/upgrade.log" 2>&1
    return $?
  fi
  trap clean_tmp EXIT
  local BREWAU_JOB="${1:-upgrade}" RESULT_DEST="${BREWAU_STATE_DIR}/last-result.json"
  local LAST_RUN="${LAST_RUN}"
  case "${BREWAU_JOB}" in
    scan) LAST_RUN="${BREWAU_STATE_DIR}/last-scan"; RESULT_DEST="${BREWAU_STATE_DIR}/last-scan-result.json" ;;
    upgrade) ;;
    *) brewau_die "expected scan or upgrade" ;;
  esac
  result_init || exit 1
  if ! brewau_cache_forbidden_taps; then
    log "could not determine which taps to block; not running brew"
    result_error tap-check brew-error || exit 1
    write_state "tap-check-failed" ""
    exit 1
  fi
  case "${1:-upgrade}" in
    scan) run_scan ;;
    upgrade) run_upgrade ;;
    *) brewau_die "expected scan or upgrade" ;;
  esac
}

if [[ -z "${BREWAU_UPGRADE_TEST:-}" ]]; then
  main "$@"
fi
