#!/bin/bash -p
# brewau-upgrade: scheduled unattended update, run by launchd as _brewau.
#
# brewau-agent serializes scheduled and manual work with an OS file lock.

set -u

# Never trust the caller's PATH: sudo passes it through, so a program planted
# in it would run with this script's privileges.
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

BREWAU_LIBEXEC="/opt/brewau/libexec"
# shellcheck source=common.sh
source "${BREWAU_LIBEXEC}/common.sh"
BREWAU_PASSTHROUGH_ENV="HOMEBREW_NO_AUTO_UPDATE=1"

LAST_RUN="${BREWAU_STATE_DIR}/last-run"
# Asks the root self-update job (brewau-agent self-update) to update brewau
# itself once this run is over: its package cannot install while this job runs.
SELF_UPDATE_DUE="${BREWAU_STATE_DIR}/self-update-due"
# Formulae this job pinned because of UPGRADE_EXCLUDE, so it only ever unpins
# its own pins and leaves pins made by users alone.
EXCLUDE_PINS="${BREWAU_STATE_DIR}/exclude-pins"

log() {
  echo "$(date '+%Y-%m-%dT%H:%M:%S%z') [${BREWAU_JOB:-upgrade}] $*"
}

log_output() {
  local line
  while IFS= read -r line || [[ -n "${line}" ]]; do
    log "brew: ${line}"
  done
}

brew_run() {
  (brewau_exec_brew "$@")
}

# last-result.json: UTC finished, job, status, reason, and upgraded/failed/blocked
# arrays of {name, kind, version, reason}; blocked adds installed for retry matching.
# errors is an append-only array of {stage, reason} for this run. The first error
# determines status=<stage>-failed/reason; errors outrank blocked, then ok/skipped.
# App Management cask failures are blocks, not job errors (including new blocks).
result_init() {
  local file="${BREWAU_STATE_DIR}/blocked-casks.json" blocked count i field valid=1
  if [[ -e "${BREWAU_STATE_DIR}/clear-blocked" ]]; then
    rm -f "${file}" "${BREWAU_STATE_DIR}/clear-blocked" || return 1
  fi
  RESULT="${BREWAU_STATE_DIR}/last-result.json.tmp"
  printf '{"upgraded":[],"failed":[],"blocked":[],"errors":[]}' >"${RESULT}" || return 1
  if [[ -r "${file}" ]]; then
    blocked="$(plutil -extract blocked json -o - "${file}" 2>/dev/null)" || valid=0
    count="$(plutil -extract blocked raw -o - "${file}" 2>/dev/null)" || valid=0
    [[ "${blocked}" == \[* && "${count}" =~ ^[0-9]+$ ]] || valid=0
    if [[ ${valid} == 1 ]]; then
      for ((i=0; i<count; i++)); do
        for field in name kind version reason installed; do
          plutil -extract "blocked.${i}.${field}" raw -o - "${file}" >/dev/null 2>&1 || valid=0
        done
      done
    fi
    if [[ ${valid} == 1 ]]; then
      plutil -replace blocked -json "${blocked}" "${RESULT}" || return 1
    else
      log "invalid blocked-casks.json; resetting blocked casks"
      rm -f "${file}" || return 1
    fi
  fi
}

result_item() {
  local array="$1" name="$2" kind="$3" version="$4" reason="$5" installed="${6:-}" item count
  item='{"name":""}'
  item="$(plutil -replace name -string "${name}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert kind -string "${kind}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert version -string "${version}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert reason -string "${reason}" -o - - <<<"${item}")" || return 1
  item="$(plutil -insert installed -string "${installed}" -o - - <<<"${item}")" || return 1
  item="$(plutil -convert json -o - - <<<"${item}")" || return 1
  count="$(plutil -extract "${array}" raw -o - "${RESULT}")" || return 1
  plutil -insert "${array}.${count}" -json "${item}" "${RESULT}"
}

result_error() {
  local stage="$1" reason="$2" item count
  item="$(plutil -replace stage -string "${stage}" -o - - <<<'{"stage":""}')" || return 1
  item="$(plutil -insert reason -string "${reason}" -o - - <<<"${item}")" || return 1
  count="$(plutil -extract errors raw -o - "${RESULT}")" || return 1
  plutil -insert "errors.${count}" -json "${item}" "${RESULT}"
}

# Set the caller's status/reason from the complete result, never from the last failure.
result_status() {
  local count stage
  status="$1" reason="$2"
  count="$(plutil -extract errors raw -o - "${RESULT}")" || return 1
  if [[ ${count} -gt 0 ]]; then
    stage="$(plutil -extract errors.0.stage raw -o - "${RESULT}")" || return 1
    status="${stage}-failed"
    reason="$(plutil -extract errors.0.reason raw -o - "${RESULT}")" || return 1
  else
    count="$(plutil -extract blocked raw -o - "${RESULT}")" || return 1
    if [[ ${count} -gt 0 ]]; then status=blocked; reason=app-management; fi
  fi
}

write_state() {
  local status="$1" upgraded="$2" reason="${3:-brew-error}" finished
  finished="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  result_status "${status}" "${reason}" || return 1
  {
    echo "finished=${finished}"
    echo "status=${status}"
    echo "upgraded=${upgraded}"
  } >"${LAST_RUN}.tmp" && mv -f "${LAST_RUN}.tmp" "${LAST_RUN}"
  plutil -insert finished -string "${finished}" "${RESULT}" &&
    plutil -insert job -string "${BREWAU_JOB:-upgrade}" "${RESULT}" &&
    plutil -insert status -string "${status}" "${RESULT}" &&
    plutil -insert reason -string "${reason}" "${RESULT}" &&
    plutil -convert json "${RESULT}" &&
    mv -f "${RESULT}" "${RESULT_DEST:-${BREWAU_STATE_DIR}/last-result.json}"
}

# Only connection failures mean offline; TLS/HTTP problems remain brew errors.
network_available() {
  local rc=0
  /usr/bin/curl -sS -I --connect-timeout 5 --max-time 10 -o /dev/null \
    https://formulae.brew.sh/api/formula.json 2>/dev/null || rc=$?
  case "${rc}" in 6 | 7 | 28) return 1 ;; esac
  return 0
}

blocked_match() {
  local name="$1" version="$2" installed="$3" count i file="${BREWAU_STATE_DIR}/blocked-casks.json"
  [[ -r "${file}" ]] || return 1
  count="$(plutil -extract blocked raw -o - "${file}" 2>/dev/null)" || return 1
  [[ "${count}" =~ ^[0-9]+$ ]] || return 1
  for ((i=0; i<count; i++)); do
    [[ "$(plutil -extract "blocked.${i}.name" raw -o - "${file}")" == "${name}" &&
       "$(plutil -extract "blocked.${i}.version" raw -o - "${file}")" == "${version}" &&
       "$(plutil -extract "blocked.${i}.installed" raw -o - "${file}")" == "${installed}" ]] && return 0
  done
  return 1
}

package_field() {
  local kind="$1" name="$2" field="$3" count i
  count="$(plutil -extract "${kind}" raw -o - - <<<"${json}")" || return 1
  for ((i=0; i<count; i++)); do
    [[ "$(plutil -extract "${kind}.${i}.name" raw -o - - <<<"${json}")" == "${name}" ]] || continue
    if [[ "${field}" == current_version ]]; then
      plutil -extract "${kind}.${i}.${field}" raw -o - - <<<"${json}"
    else
      plutil -extract "${kind}.${i}.${field}" json -o - - <<<"${json}"
    fi
    return
  done
  return 1
}

# True if formula or cask $1 is in UPGRADE_EXCLUDE. Either may name it with or
# without its tap: Homebrew prints tap packages as user/repo/name.
excluded() {
  local word
  for word in ${UPGRADE_EXCLUDE}; do
    [[ "${word##*/}" == "${1##*/}" ]] && return 0
  done
  return 1
}

# Prints the arguments that are not excluded.
not_excluded() {
  local name
  for name in "$@"; do
    excluded "${name}" || echo "${name}"
  done
}

# Prints the outdated, unpinned names of kind $1 (formulae or casks) from the
# `brew outdated --json=v2` output in $2. Homebrew refuses to upgrade a pinned
# package named on the command line, so pins must be left out here.
outdated_names() {
  local kind="$1" json="$2" count i
  count="$(plutil -extract "${kind}" raw -o - - <<<"${json}" 2>/dev/null)" || return 1
  [[ "${count}" =~ ^[0-9]+$ ]] || return 1
  for ((i = 0; i < count; i++)); do
    [[ "$(plutil -extract "${kind}.${i}.pinned" raw -o - - <<<"${json}" 2>/dev/null)" == "true" ]] && continue
    plutil -extract "${kind}.${i}.name" raw -o - - <<<"${json}" 2>/dev/null || return 1
  done
}

# `brew upgrade` also upgrades outdated dependencies of what it upgrades, so
# leaving a formula off the command line does not exclude it. A pin does.
# Reconciles against the actual pins every run, so a pin that disappeared
# (brew unpin, reinstall) is put back. Fails if the pins cannot be verified.
# Pins and the installed list use plain names, so UPGRADE_EXCLUDE entries are
# reduced to theirs.
sync_exclude_pins() {
  local installed pinned previous="" word name kept="" result=0
  installed="$(brew_run list --formula -1)" || return 1
  pinned="$(brew_run list --pinned --formula)" || return 1
  [[ -r "${EXCLUDE_PINS}" ]] && previous="$(cat "${EXCLUDE_PINS}")"

  for name in ${previous}; do
    excluded "${name}" && continue
    brewau_in_words "${name}" "${pinned}" || continue
    log "unpinning ${name} (no longer in UPGRADE_EXCLUDE)"
    brew_run unpin "${name}" || { kept="${kept} ${name}"; result=1; }
  done
  for word in ${UPGRADE_EXCLUDE}; do
    name="${word##*/}"
    brewau_in_words "${name}" "${installed}" || continue
    brewau_in_words "${name}" "${kept}" && continue
    if brewau_in_words "${name}" "${pinned}"; then
      # Keep owning our own pins; a pin someone else made is respected but
      # not taken over, so it is never unpinned by this job.
      brewau_in_words "${name}" "${previous}" && kept="${kept} ${name}"
      continue
    fi
    log "pinning ${name} (UPGRADE_EXCLUDE)"
    if brew_run pin "${name}"; then
      kept="${kept} ${name}"
    else
      result=1
    fi
  done
  echo "${kept# }" >"${EXCLUDE_PINS}"
  return "${result}"
}

# A system service keeps running the old binary after its formula is
# upgraded, so restart the ones that are loaded. Fails if one did not restart.
restart_system_services() {
  local name result=0
  for name in "$@"; do
    name="${name##*/}"
    brewau_service_allowed "${name}" || continue
    brewau_service_loaded system "${name}" || continue
    log "restarting system service ${name}"
    if ! (brewau_exec_brew_as_root services restart "${name}"); then
      log "could not restart ${name}"
      result=1
    fi
    brewau_release_service_keg "${name}"
  done
  return "${result}"
}

# Homebrew leaves temp files behind when a cask fails; keep the directory small.
clean_tmp() {
  find "${BREWAU_TMP}" -mindepth 1 -maxdepth 1 -type d -name 'cask-*' -user "${BREWAU_USER}" -mtime +1 -exec rm -rf {} + 2>/dev/null
  return 0
}

run_upgrade() {
  local status="ok" greedy="" formulae="" casks="" output json name
  local upgraded="" reason=ok version installed kind item_reason package_greedy enumeration_ok=1
  result_init || return 1
  if ! network_available; then
    log "offline, skipped"
    log "done (offline)"
    write_state skipped "" offline
    clean_tmp
    return 0
  fi
  [[ "${UPGRADE_GREEDY}" == "1" ]] && greedy="--greedy"

  log "brew update"
  if ! brew_run update; then
    result_error update brew-error || return 1
    write_state "update-failed" ""
    clean_tmp
    log "done (update-failed)"
    return 1
  fi

  # Every run, not only when casks are outdated: an updater can replace an app
  # at any time. Upgrading a cask runs code from its app, so a cask whose app
  # could not be locked is not upgraded.
  local unprotected="" protect_rc=0
  unprotected="$(brewau_protect_installed_apps /usr/bin/sudo -n)" || protect_rc=$?
  if [[ ${protect_rc} -ne 0 ]]; then
    log "not upgrading casks whose apps could not be protected: ${unprotected:-all of them}"
    result_error protect protect-failed || return 1
  fi

  # Without verified pins an excluded formula could be upgraded as a
  # dependency, so formulae are skipped rather than risk it.
  local formulae_ok=1
  if ! sync_exclude_pins; then
    log "could not verify UPGRADE_EXCLUDE pins"
    result_error pin brew-error || return 1
    [[ -n "${UPGRADE_EXCLUDE}" ]] && formulae_ok=0
  fi

  # Check each command's exit status: inside a substitution a failure would
  # otherwise look like "nothing is outdated".
  # shellcheck disable=SC2086
  if json="$(brew_run outdated --json=v2 ${greedy})"; then
    plutil -replace blocked -json '[]' "${RESULT}" || return 1
    if [[ ${formulae_ok} -eq 1 ]]; then
      if output="$(outdated_names formulae "${json}")"; then
        # shellcheck disable=SC2086
        formulae="$(not_excluded ${output})"
      else
        log "could not list outdated formulae"
        result_error outdated brew-error || return 1
        enumeration_ok=0
      fi
    fi
    if output="$(outdated_names casks "${json}")"; then
      # shellcheck disable=SC2086
      for name in $(not_excluded ${output}); do
        # brewau updates itself after this run (SELF_UPDATE_DUE).
        [[ "${name##*/}" == "brewau" ]] && continue
        if [[ ${protect_rc} -eq 2 ]] || brewau_in_words "${name##*/}" "${unprotected}"; then
          version="$(package_field casks "${name}" current_version)" || version="unknown"
          installed="$(package_field casks "${name}" installed_versions)" || installed='null'
          if blocked_match "${name}" "${version}" "${installed}"; then
            result_item blocked "${name}" cask "${version}" app-management "${installed}" || return 1
          fi
          result_item failed "${name}" cask "${version}" protect-failed || return 1
        else
          casks="${casks} ${name}"
        fi
      done
    else
      log "could not list outdated casks"
      result_error outdated brew-error || return 1
      enumeration_ok=0
    fi
  else
    log "could not list outdated packages"
    result_error outdated brew-error || return 1
    enumeration_ok=0
  fi

  # Keep successful packages when another package fails in the same run.
  for kind in formula cask; do
    if [[ "${kind}" == formula ]]; then
      output="${formulae}"
      package_greedy=""
    else
      output="${casks}"
      package_greedy="${greedy}"
    fi
    for name in ${output}; do
      if [[ "${kind}" == formula ]]; then
        version="$(package_field formulae "${name}" current_version)" || version='null'
        installed=""
      else
        version="$(package_field casks "${name}" current_version)" || version='null'
        installed="$(package_field casks "${name}" installed_versions)" || installed='null'
        if blocked_match "${name}" "${version}" "${installed}"; then
          result_item blocked "${name}" cask "${version}" app-management "${installed}" || return 1
          log "${name}: blocked by macOS App Management; skipped"
          continue
        fi
      fi
      log "upgrading ${kind}: ${name}"
      # shellcheck disable=SC2086
      if output="$(brew_run upgrade --${kind} ${package_greedy} "${name}" 2>&1)"; then
        log_output <<<"${output}"
        upgraded="${upgraded:+${upgraded} }${name}"
        result_item upgraded "${name}" "${kind}" "${version}" ok || return 1
        if [[ "${kind}" == formula ]]; then
          restart_system_services "${name}" || { result_error restart brew-error || return 1; }
        fi
      else
        log_output <<<"${output}"
        item_reason=brew-error
        if [[ "${kind}" == cask ]] && { [[ "${output}" == *"App Management permissions"* ]] ||
          printf '%s\n' "${output}" | /usr/bin/grep -Eq '/Applications/[^[:cntrl:]]+\.app[^[:cntrl:]]*Operation not permitted|Operation not permitted[^[:cntrl:]]*/Applications/[^[:cntrl:]]+\.app'; }; then
          item_reason=app-management
          result_item blocked "${name}" cask "${version}" "${item_reason}" "${installed}" || return 1
        fi
        result_item failed "${name}" "${kind}" "${version}" "${item_reason}" || return 1
        if [[ "${item_reason}" != app-management ]]; then
          result_error upgrade "${item_reason}" || return 1
        fi
      fi
    done
  done
  if [[ -n "${casks}" ]] && ! brewau_protect_installed_apps /usr/bin/sudo -n >/dev/null; then
    result_error protect protect-failed || return 1
  fi
  # Replace the block list only after a successful outdated query, so offline
  # or failed enumeration cannot accidentally clear a block.
  if [[ ${enumeration_ok} == 1 ]]; then
    cp "${RESULT}" "${BREWAU_STATE_DIR}/blocked-casks.json.tmp" &&
      mv -f "${BREWAU_STATE_DIR}/blocked-casks.json.tmp" "${BREWAU_STATE_DIR}/blocked-casks.json" || return 1
  fi
  result_status ok ok || return 1
  [[ -z "${formulae}${casks}" && "${status}" == "ok" ]] && log "everything is up to date"

  log "brew cleanup"
  brew_run cleanup "--prune=${CLEANUP_PRUNE_DAYS}" || { result_error cleanup brew-error || return 1; }
  clean_tmp

  if ! refresh_snapshot; then
    log "could not refresh the GUI snapshot"
    result_error snapshot brew-error || return 1
  fi

  result_status ok ok || return 1
  write_state "${status}" "${upgraded}" "${reason}" || return 1
  touch "${SELF_UPDATE_DUE}" || log "could not ask for a brewau self-update"
  log "done (${status})"
  [[ "${status}" == "ok" || "${status}" == blocked ]]
}

# Publish complete JSON files atomically; a failed scan leaves the last good data intact.
refresh_snapshot() {
  local greedy="" json catalog version
  [[ "${UPGRADE_GREEDY}" == "1" ]] && greedy="--greedy"
  # shellcheck disable=SC2086
  json="$(brew_run outdated --json=v2 ${greedy})" || return 1
  plutil -extract formulae raw -o - - <<<"${json}" >/dev/null 2>&1 || return 1
  plutil -extract casks raw -o - - <<<"${json}" >/dev/null 2>&1 || return 1
  catalog="$(brew_run info --json=v2 --installed --cask)" || return 1
  plutil -extract casks raw -o - - <<<"${catalog}" >/dev/null 2>&1 || return 1
  printf '%s\n' "${catalog}" >"${BREWAU_STATE_DIR}/catalog.json.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/catalog.json.tmp" "${BREWAU_STATE_DIR}/catalog.json" || return 1
  printf '%s\n' "${json}" >"${BREWAU_STATE_DIR}/updates.json.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/updates.json.tmp" "${BREWAU_STATE_DIR}/updates.json" || return 1
  version="$(brew_run --version)" || return 1
  printf '%s\n' "${version%%$'\n'*}" >"${BREWAU_STATE_DIR}/homebrew-version.tmp" &&
    mv -f "${BREWAU_STATE_DIR}/homebrew-version.tmp" "${BREWAU_STATE_DIR}/homebrew-version"
}

run_scan() {
  local BREWAU_JOB="scan" status=ok reason=ok
  local LAST_RUN="${BREWAU_STATE_DIR}/last-scan" RESULT
  local RESULT_DEST="${BREWAU_STATE_DIR}/last-scan-result.json"
  result_init || return 1
  if ! network_available; then
    log "offline, skipped"
    log "done (offline)"
    write_state skipped "" offline
    clean_tmp
    return 0
  fi
  if [[ "${UPDATE_HOMEBREW}" == "1" ]]; then
    log "brew update (scan)"
    if ! brew_run update; then
      log "done (update-failed)"
      result_error update brew-error || return 1
      write_state update-failed "" brew-error
      clean_tmp
      return 1
    fi
  fi
  refresh_snapshot || { result_error snapshot brew-error || return 1; }
  result_status ok ok || return 1
  write_state "${status}" "" "${reason}" || return 1
  clean_tmp
  log "done (${status})"
  [[ "${status}" == ok || "${status}" == blocked ]]
}

# With AUTO_UPGRADE=0 the LaunchDaemon has no schedule, so the job only runs
# when started with `brewau run`.
main() {
  [[ "$(id -un)" == "${BREWAU_USER}" ]] || brewau_die "brewau-upgrade must run as ${BREWAU_USER}"
  trap clean_tmp EXIT
  brewau_load_config
  local BREWAU_JOB="${1:-upgrade}" RESULT_DEST="${BREWAU_STATE_DIR}/last-result.json"
  local LAST_RUN="${LAST_RUN}"
  case "${BREWAU_JOB}" in
    scan) LAST_RUN="${BREWAU_STATE_DIR}/last-scan"; RESULT_DEST="${BREWAU_STATE_DIR}/last-scan-result.json" ;;
    upgrade) ;;
    *) brewau_die "expected scan or upgrade" ;;
  esac
  result_init || exit 1
  if ! brewau_cache_forbidden_taps; then
    log "could not determine which taps to block; not running brew"
    result_error tap-check brew-error || exit 1
    write_state "tap-check-failed" ""
    exit 1
  fi
  case "${1:-upgrade}" in
    scan) run_scan ;;
    upgrade) run_upgrade ;;
    *) brewau_die "expected scan or upgrade" ;;
  esac
}

if [[ -z "${BREWAU_UPGRADE_TEST:-}" ]]; then
  main "$@"
fi
