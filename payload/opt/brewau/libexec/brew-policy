#!/bin/bash -p
# brew-policy: the security boundary between a user and the _brewau account.
#
# Invoked by /opt/brewau/bin/brew via `sudo -u _brewau`. Anything this script
# lets through runs as _brewau, which has passwordless sudo, so the default is
# to deny. Only allowlisted subcommands, options and package names pass.

set -u

# Never trust the caller's PATH: sudo passes it through, so a program planted
# in it would run with this script's privileges.
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# sudo runs this file by its absolute path from sudoers, so this resolves to
# /opt/brewau/libexec in production and to the repo checkout in tests.
BREWAU_LIBEXEC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=common.sh
source "${BREWAU_LIBEXEC}/common.sh"

# Lists below are whitespace-separated words (see brewau_in_words).

# Subcommands that only read state.
READ_COMMANDS=" --version -v --prefix --cellar --repository --repo --cache --caskroom --env --config
  config doctor dr list ls info abv search -S outdated deps uses leaves desc options missing
  tap-info commands help -h --help formulae casks shellenv "

# Subcommands that change the prefix or /Applications.
WRITE_COMMANDS=" install reinstall upgrade uninstall remove rm autoremove cleanup update update-reset
  link ln unlink pin unpin tap untap fetch analytics completions migrate "

# Commands whose arguments are free text and never resolved as files.
FREE_TEXT_COMMANDS=" search -S help -h --help commands "

# No --adopt: it registers an app the user already owns (and can still change)
# as a cask, whose install and uninstall steps then run code from inside it.
ALLOWED_OPTIONS=" -v --verbose -q --quiet -f --force -n --dry-run -h --help
  --formula --formulae --cask --casks --greedy --greedy-latest --greedy-auto-updates
  --zap --overwrite --ignore-dependencies --only-dependencies --skip-cask-deps
  --skip-post-install --skip-link --require-sha --fetch-HEAD --HEAD --build-from-source -s
  --force-bottle --installed --eval-all --desc --name --description --versions --pinned
  --full-name --multiple --tree --direct --recursive --include-build --include-test
  --include-optional --skip-recommended --annotate --dependents --display-times --ask
  --json --json=v1 --json=v2 --scrub --deps --repair --installed-on-request
  --installed-as-dependency --poured-from-bottle --built-from-source --missing --declared
  --list-checks --unbrewed --auto-update --no-upgrade -1 -l -r -t --fish --zsh --bash
  --on-request --as-dependency --leaves --print-path --names --size --plain "

# Commands that can put cask apps in place. Their apps are locked right after,
# so that users never get to change code a later cask step runs as _brewau.
CASK_INSTALL_COMMANDS=" install reinstall upgrade "

# Commands that can run a cask's uninstall steps, i.e. code from inside its
# app (`install` upgrades an installed cask that is outdated).
CASK_UNINSTALL_COMMANDS=" install uninstall remove rm reinstall upgrade "

NAME_RE='^[A-Za-z0-9][A-Za-z0-9@._+-]*$'
TAP_RE='^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$'
QUALIFIED_RE='^([A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*)/[A-Za-z0-9][A-Za-z0-9@._+-]*$'

DENY_REASON=""
SERVICE_ACTION=""
SERVICE_NAME=""

deny() {
  DENY_REASON="$*"
  return 1
}

option_allowed() {
  local opt="$1"
  brewau_in_words "${opt}" "${ALLOWED_OPTIONS}" && return 0
  brewau_in_words "${opt}" "${EXTRA_ALLOWED_OPTIONS}" && return 0
  [[ "${opt}" =~ ^--prune=([0-9]+|all)$ ]] && return 0
  [[ "${opt}" =~ ^--shell=(bash|zsh|fish|csh|pwsh)$ ]] && return 0
  return 1
}

check_package_arg() {
  local arg="$1" tap
  if [[ "${arg}" =~ ${QUALIFIED_RE} ]]; then
    tap="${BASH_REMATCH[1]}"
    brewau_tap_allowed "${tap}" || deny "tap '${tap}' is not in ALLOWED_TAPS"
    return
  fi
  [[ "${arg}" =~ ${NAME_RE} ]] || deny "'${arg}' is not a plain formula/cask name (paths and URLs are not allowed)"
}

# `brew services` runs as root (system daemons), so only a fixed set of actions
# on formulae listed in ALLOWED_SERVICES passes. Options such as --file
# (an arbitrary plist) or --sudo-service-user are refused. Services that are
# not allowed run as the user instead; the brew wrapper handles those.
# Like Homebrew, the first word is the action (default list), the second the
# formula, wherever the options are. Sets SERVICE_ACTION and SERVICE_NAME.
check_services() {
  local arg action="" name="" json=0
  for arg in "$@"; do
    case "${arg}" in
      -v | --verbose | -q | --quiet) ;;
      --json) json=1 ;;
      -*) deny "option '${arg}' is not allowed for brew services"; return ;;
      *)
        if [[ -z "${action}" ]]; then
          action="${arg}"
        elif [[ -z "${name}" ]]; then
          name="${arg}"
        else
          deny "brew services takes one formula"
          return
        fi
        ;;
    esac
  done
  action="$(brewau_service_action "${action:-list}")"
  case "${action}" in
    list | info | start | stop | restart | kill) ;;
    # Homebrew refuses `run` as root; `start` is the system equivalent.
    run) deny "'brew services run' cannot run a system service; use: brew services start ${name}"; return ;;
    *) deny "'brew services ${action}' is not allowed"; return ;;
  esac
  if [[ ${json} -eq 1 && "${action}" != "list" && "${action}" != "info" ]]; then
    deny "option '--json' is not allowed for brew services ${action}"
    return
  fi
  SERVICE_ACTION="${action}"
  SERVICE_NAME="${name}"
  if [[ "${action}" == "list" ]]; then
    [[ -z "${name}" ]] || { deny "brew services list takes no formula"; return; }
    return 0
  fi
  [[ -n "${name}" ]] || { deny "brew services ${action} needs a formula"; return; }
  [[ "${name}" =~ ${NAME_RE} ]] || { deny "'${name}' is not a plain formula name"; return; }
  brewau_service_allowed "${name}" ||
    deny "'${name}' is not in ALLOWED_SERVICES, so it cannot run as a system service"
}

# Validates a full brew command line. Returns non-zero and sets DENY_REASON
# when the command must not run.
check_command() {
  # brew.sh moves a leading -v to the end, so `brew -v sh` runs `brew sh -v`.
  # Validate the command line the way brew will see it.
  if [[ "${1:-}" == "-v" && $# -gt 1 ]]; then
    shift
    set -- "$@" -v
  fi

  local cmd="${1:-}" arg
  [[ $# -gt 0 ]] && shift

  if [[ -z "${cmd}" ]]; then
    return 0
  fi

  if [[ "${cmd}" == "services" ]]; then
    check_services "$@"
    return
  fi

  if ! brewau_in_words "${cmd}" "${READ_COMMANDS}" && ! brewau_in_words "${cmd}" "${WRITE_COMMANDS}"; then
    deny "'brew ${cmd}' is not allowed by policy"
    return
  fi

  case "${cmd}" in
    tap)
      local positional=0
      for arg in "$@"; do
        if [[ "${arg}" == -* ]]; then
          option_allowed "${arg}" || { deny "option '${arg}' is not allowed"; return; }
          continue
        fi
        positional=$((positional + 1))
        [[ ${positional} -gt 1 ]] && { deny "custom tap remotes are not allowed"; return; }
        [[ "${arg}" =~ ${TAP_RE} ]] || { deny "'${arg}' is not a valid tap name"; return; }
        brewau_tap_allowed "${arg}" || { deny "tap '${arg}' is not in ALLOWED_TAPS"; return; }
      done
      return 0
      ;;
    untap | tap-info)
      for arg in "$@"; do
        if [[ "${arg}" == -* ]]; then
          option_allowed "${arg}" || { deny "option '${arg}' is not allowed"; return; }
          continue
        fi
        [[ "${arg}" =~ ${TAP_RE} ]] || { deny "'${arg}' is not a valid tap name"; return; }
      done
      return 0
      ;;
    update-reset)
      # Its arguments are repository paths (relative to /, where brew runs).
      for arg in "$@"; do
        [[ "${arg}" == -* ]] && option_allowed "${arg}" && continue
        deny "brew update-reset takes no arguments"
        return
      done
      return 0
      ;;
    analytics)
      [[ $# -le 1 ]] || { deny "too many arguments"; return; }
      case "${1:-state}" in on | off | state) return 0 ;; esac
      deny "brew analytics accepts on|off|state"
      return
      ;;
  esac

  if brewau_in_words "${cmd}" "${FREE_TEXT_COMMANDS}"; then
    for arg in "$@"; do
      [[ "${arg}" == -* ]] && ! option_allowed "${arg}" && { deny "option '${arg}' is not allowed"; return; }
    done
    return 0
  fi

  for arg in "$@"; do
    if [[ "${arg}" == "--" ]]; then
      deny "'--' is not allowed"
      return
    elif [[ "${arg}" == -* ]]; then
      option_allowed "${arg}" || { deny "option '${arg}' is not allowed"; return; }
    else
      check_package_arg "${arg}" || return
    fi
  done
  return 0
}

audit() {
  local decision="$1" argv=""
  shift
  [[ -w "${BREWAU_AUDIT_LOG}" || -w "${BREWAU_LOG_DIR}" ]] || return 0
  # Quote every argument so newlines or other control characters in free-text
  # arguments cannot forge log lines.
  [[ $# -gt 0 ]] && argv="$(printf '%q ' "$@")"
  printf '%s user=%s decision=%s argv=%s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${SUDO_USER:-unknown}" "${decision}" "${argv% }" >>"${BREWAU_AUDIT_LOG}" 2>/dev/null
}

# Only pass through presentation variables, and only with harmless values.
passthrough_env() {
  local out="" name value
  for name in TERM COLUMNS LINES LANG LC_ALL NO_COLOR; do
    value="$(printenv "${name}" 2>/dev/null)" || continue
    [[ "${value}" =~ ^[A-Za-z0-9._@-]{1,64}$ ]] || continue
    out="${out} ${name}=${value}"
  done
  echo "${out}"
}

# True if subcommand $2 with the arguments after it (an already allowed
# command line) is in list $1 and can act on casks.
cask_command() {
  local list="$1" cmd="$2" arg
  shift 2
  brewau_in_words "${cmd}" "${list}" || return 1
  for arg in "$@"; do
    case "${arg}" in --formula | --formulae) return 1 ;; esac
  done
  return 0
}

# Locks the cask apps before a command that can run code from them, and fails
# (setting DENY_REASON) if an app it may touch is still unprotected: anyone
# could have changed that code. $@ are the arguments after the subcommand;
# without package names, every cask counts.
cask_apps_protected() {
  local unprotected rc=0 arg names=0
  unprotected="$(brewau_protect_installed_apps /usr/bin/sudo -n)" || rc=$?
  case "${rc}" in
    0) return 0 ;;
    2) deny "the installed casks could not be listed to check their apps"; return ;;
  esac
  for arg in "$@"; do
    [[ "${arg}" == -* ]] && continue
    names=1
    brewau_in_words "${arg##*/}" "${unprotected}" &&
      { deny "the app of ${arg##*/} could not be protected or verified, so its code cannot be trusted"; return; }
  done
  [[ ${names} -eq 0 ]] || return 0
  deny "the apps of ${unprotected//$'\n'/ } could not be protected or verified, so their code cannot be trusted"
}

# Runs brew, then locks the cask apps, also when brew fails or is interrupted.
run_then_protect_apps() {
  local rc=0
  # Traps (unlike ignored signals) leave brew interruptible...
  trap ':' INT TERM HUP QUIT PIPE
  (brewau_exec_brew "$@") || rc=$?
  # ...but the locking, and the root helper it runs, must not be stopped.
  trap '' INT TERM HUP QUIT PIPE
  brewau_protect_installed_apps /usr/bin/sudo -n >/dev/null
  brewau_refresh_completions || true
  trap - INT TERM HUP QUIT PIPE
  return "${rc}"
}

# Runs `brew services` as root, then hands a started service's keg back (see
# brewau_release_service_keg).
run_system_services() {
  local rc=0
  # launchd (as root) writes the service logs here; keep it owned by us.
  mkdir -p "${HOMEBREW_PREFIX_PATH}/var/log" 2>/dev/null
  (brewau_exec_brew_as_root "$@") || rc=$?
  case "${SERVICE_ACTION}" in
    start | restart) brewau_release_service_keg "${SERVICE_NAME}" >&2 ;;
  esac
  return "${rc}"
}

main() {
  [[ "$(id -un)" == "${BREWAU_USER}" ]] || brewau_die "brew-policy must run as ${BREWAU_USER}"
  brewau_load_config

  if ! check_command "$@"; then
    audit deny "$@"
    echo "brewau: denied: ${DENY_REASON}" >&2
    echo "brewau: an administrator can change the policy with: sudo brewau config" >&2
    exit 1
  fi
  audit allow "$@"

  BREWAU_PASSTHROUGH_ENV="$(passthrough_env)"
  # The subcommand and its arguments, the way brew sees them.
  local cmd="${1:-}" args=("${@:2}")
  if [[ "${cmd}" == "-v" && $# -gt 1 ]]; then
    cmd="$2"
    args=("${@:3}" -v)
  fi
  if [[ "${cmd}" == "services" ]]; then
    run_system_services "$@"
    exit
  fi
  if cask_command "${CASK_UNINSTALL_COMMANDS}" "${cmd}" ${args[@]+"${args[@]}"} && ! cask_apps_protected ${args[@]+"${args[@]}"}; then
    echo "brewau: denied: ${DENY_REASON}" >&2
    echo "brewau: an administrator needs to look at it; see: brewau doctor" >&2
    exit 1
  fi
  if cask_command "${CASK_INSTALL_COMMANDS}" "${cmd}" ${args[@]+"${args[@]}"}; then
    run_then_protect_apps "$@"
    exit
  fi
  if brewau_in_words "${cmd}" "install reinstall upgrade uninstall remove rm update update-reset cleanup link unlink"; then
    local rc=0
    (brewau_exec_brew "$@") || rc=$?
    brewau_refresh_completions || true
    return "${rc}"
  fi
  brewau_exec_brew "$@"
}

if [[ -z "${BREWAU_POLICY_TEST:-}" ]]; then
  main "$@"
fi
