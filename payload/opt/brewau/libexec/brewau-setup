#!/bin/bash -p
# brewau-setup: privileged lifecycle operations. Must run as root.
#
#   brewau-setup install [user...]   create accounts, take over the prefix, load daemon;
#                                    also repairs an existing installation
#   brewau-setup reload              regenerate sudoers, brew.env + LaunchDaemon from brewau.conf
#   brewau-setup allow-user <user>   grant a user access to brew
#   brewau-setup deny-user <user>    revoke a user's access to brew
#   brewau-setup uninstall           restore vanilla Homebrew owned by the original user

set -euo pipefail

# Never trust the caller's PATH: sudo passes it through, so a program planted
# in it would run with this script's privileges.
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

BREWAU_LIBEXEC="/opt/brewau/libexec"
# shellcheck source=common.sh
source "${BREWAU_LIBEXEC}/common.sh"

NEWSYSLOG_CONF="/etc/newsyslog.d/brewau.conf"
ORIGINAL_OWNER_FILE="${BREWAU_ROOT}/etc/original-owner"
# Modes of prefix paths whose group/world write bit brewau removed, so
# uninstall can put them back.
ORIGINAL_MODES_FILE="${BREWAU_ROOT}/etc/original-modes"
# Written after the first successful install. Users are only granted access
# automatically before it exists, so `deny-user` survives upgrades.
INSTALLED_MARKER="${BREWAU_ROOT}/etc/installed"
PKG_ID="com.kastruppro.brewau"

log() { echo "brewau-setup: $*"; }

require_root() {
  [[ "$(id -u)" -eq 0 ]] || brewau_die "this command must run as root (use sudo)"
}

console_user() {
  local user
  user="$(stat -f%Su /dev/console 2>/dev/null || true)"
  case "${user}" in "" | root | loginwindow | _mbsetupuser) return 0 ;; esac
  echo "${user}"
}

# Runs brew as _brewau with the same environment the policy uses.
brew_as_service() {
  (cd / && sudo -u "${BREWAU_USER}" /bin/bash -p -c \
    'source /opt/brewau/libexec/common.sh && brewau_load_config && brewau_exec_brew "$@"' brewau "$@")
}

# Writes `brew info --json=v2 --installed --cask` to a temp file and prints
# its path, or fails if brew could not produce it.
installed_casks_json() {
  local json
  json="$(mktemp /tmp/brewau-casks.XXXXXX)"
  if brew_as_service info --json=v2 --installed --cask >"${json}" 2>/dev/null && [[ -s "${json}" ]]; then
    echo "${json}"
    return 0
  fi
  rm -f "${json}"
  return 1
}

free_id() {
  local id
  for ((id = 400; id < 500; id++)); do
    if ! dscl . -search /Users UniqueID "${id}" | grep -q . &&
      ! dscl . -search /Groups PrimaryGroupID "${id}" | grep -q .; then
      echo "${id}"
      return 0
    fi
  done
  brewau_die "no free system UID/GID between 400 and 499"
}

ensure_service_account() {
  if dscl . -read "/Users/${BREWAU_USER}" >/dev/null 2>&1; then
    return 0
  fi
  local id
  id="$(free_id)"
  log "creating service account ${BREWAU_USER} (uid/gid ${id})"
  dscl . -create "/Groups/${BREWAU_GROUP}"
  dscl . -create "/Groups/${BREWAU_GROUP}" PrimaryGroupID "${id}"
  dscl . -create "/Groups/${BREWAU_GROUP}" RealName "brewau service"
  dscl . -create "/Groups/${BREWAU_GROUP}" Password "*"

  dscl . -create "/Users/${BREWAU_USER}"
  dscl . -create "/Users/${BREWAU_USER}" UniqueID "${id}"
  dscl . -create "/Users/${BREWAU_USER}" PrimaryGroupID "${id}"
  dscl . -create "/Users/${BREWAU_USER}" RealName "brewau service"
  dscl . -create "/Users/${BREWAU_USER}" NFSHomeDirectory "${BREWAU_HOME}"
  dscl . -create "/Users/${BREWAU_USER}" UserShell /usr/bin/false
  dscl . -create "/Users/${BREWAU_USER}" Password "*"
  dscl . -create "/Users/${BREWAU_USER}" IsHidden 1
}

ensure_users_group() {
  if ! dscl . -read "/Groups/${BREWAU_USERS_GROUP}" >/dev/null 2>&1; then
    log "creating group ${BREWAU_USERS_GROUP}"
    dseditgroup -o create -r "brewau users" "${BREWAU_USERS_GROUP}"
  fi
}

allow_user() {
  local user="$1"
  id "${user}" >/dev/null 2>&1 || brewau_die "no such user: ${user}"
  ensure_users_group
  dseditgroup -o edit -a "${user}" -t user "${BREWAU_USERS_GROUP}"
  dscacheutil -flushcache 2>/dev/null || true
  log "granted brew access to ${user}"
}

deny_user() {
  local user="$1"
  # dseditgroup fails on a non-member. A deleted user's leftover membership
  # cannot be checked, but must still be removable.
  if id "${user}" >/dev/null 2>&1 &&
    ! dseditgroup -o checkmember -m "${user}" "${BREWAU_USERS_GROUP}" >/dev/null 2>&1; then
    log "${user} does not have brew access"
    return 0
  fi
  dseditgroup -o edit -d "${user}" -t user "${BREWAU_USERS_GROUP}"
  dscacheutil -flushcache 2>/dev/null || true
  log "revoked brew access from ${user}"
}

ensure_dirs() {
  install -d -o root -g wheel -m 0755 "${BREWAU_ROOT}" "${BREWAU_ROOT}/etc" "${BREWAU_VAR}"
  install -d -o "${BREWAU_USER}" -g "${BREWAU_GROUP}" -m 0755 \
    "${BREWAU_HOME}" "${BREWAU_LOG_DIR}" "${BREWAU_STATE_DIR}" "${BREWAU_APP_STATE_DIR}"
  # Private replacement for the shared, world-writable /tmp.
  install -d -o "${BREWAU_USER}" -g "${BREWAU_GROUP}" -m 0700 "${BREWAU_TMP}"
  local logfile
  for logfile in "${BREWAU_LOG_DIR}/upgrade.log" "${BREWAU_AUDIT_LOG}"; do
    [[ -f "${logfile}" ]] || install -o "${BREWAU_USER}" -g "${BREWAU_GROUP}" -m 0644 /dev/null "${logfile}"
  done
  # Lock files from versions before 0.2.0 could be left behind forever.
  rmdir "${BREWAU_STATE_DIR}/upgrade.lock" 2>/dev/null || true
  # The policy and setup code must never be writable by _brewau or users.
  chown -R root:wheel "${BREWAU_ROOT}/bin" "${BREWAU_ROOT}/libexec" "${BREWAU_ROOT}/share"
  chmod -R go-w "${BREWAU_ROOT}/bin" "${BREWAU_ROOT}/libexec" "${BREWAU_ROOT}/share"
}

existing_third_party_taps() {
  local dir user repo
  for dir in "${HOMEBREW_PREFIX_PATH}"/Library/Taps/*/homebrew-*; do
    [[ -d "${dir}" ]] || continue
    user="$(basename "$(dirname "${dir}")")"
    repo="$(basename "${dir}")"
    repo="${repo#homebrew-}"
    [[ "${user}" == "homebrew" ]] && continue
    [[ "${user}/${repo}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || continue
    echo "${user}/${repo}"
  done
}

ensure_config() {
  [[ -f "${BREWAU_CONF}" ]] && return 0
  local taps
  taps="$(existing_third_party_taps | tr '\n' ' ' | sed 's/ *$//')"
  sed "s|^ALLOWED_TAPS=\"\"|ALLOWED_TAPS=\"${taps}\"|" \
    "${BREWAU_ROOT}/share/brewau.conf.default" >"${BREWAU_CONF}"
  chown root:wheel "${BREWAU_CONF}"
  chmod 0644 "${BREWAU_CONF}"
  [[ -n "${taps}" ]] && log "allowed existing taps: ${taps}"
  return 0
}

take_over_prefix() {
  local owner
  owner="$(stat -f%Su "${HOMEBREW_PREFIX_PATH}")"
  if [[ "${owner}" != "${BREWAU_USER}" ]]; then
    echo "${owner}" >"${ORIGINAL_OWNER_FILE}"
    chown root:wheel "${ORIGINAL_OWNER_FILE}"
    log "transferring ${HOMEBREW_PREFIX_PATH} from ${owner} to ${BREWAU_USER}"
  fi
  chown -hR "${BREWAU_USER}:admin" "${HOMEBREW_PREFIX_PATH}"
  # `brew services` creates its log directory before starting a service, which
  # fails for users (they cannot write here), so make sure it exists.
  install -d -o "${BREWAU_USER}" -g admin -m 0755 "${HOMEBREW_PREFIX_PATH}/var" "${HOMEBREW_PREFIX_PATH}/var/log"
  # Group/world write would let admins or users plant code that _brewau (and
  # therefore root) executes. Record the old modes for uninstall first.
  touch "${ORIGINAL_MODES_FILE}"
  chown root:wheel "${ORIGINAL_MODES_FILE}"
  chmod 0644 "${ORIGINAL_MODES_FILE}"
  # One line per path, so names with a newline are not recorded.
  find "${HOMEBREW_PREFIX_PATH}" ! -type l ! -path $'*\n*' \( -perm -g+w -o -perm -o+w \) \
    -exec stat -f '%Lp %N' {} + >>"${ORIGINAL_MODES_FILE}"
  # Also removes ACLs: an ACL the previous owner set can still grant them
  # write access. Homebrew does not use ACLs. Whoever could write here can
  # still race this, so it never follows their symlinks.
  brewau_lock_tree "${HOMEBREW_PREFIX_PATH}" ||
    brewau_die "could not remove group/world write and ACLs from ${HOMEBREW_PREFIX_PATH}"
}

# Whoever owned the prefix before could have changed Homebrew's code, which
# _brewau (and so root) now runs. Flags what git can tell: local changes,
# commits that are not upstream, and config or hooks that run commands. Only
# runs git on a repository whose config is harmless.
check_repos() {
  local dir problems found=0
  # As _brewau, which owns the repositories now, and without writing the index.
  local git=(sudo -u "${BREWAU_USER}" -H git --no-optional-locks -c core.fsmonitor=false -c core.hooksPath=/dev/null)
  while IFS= read -r dir; do
    problems="$(brewau_repo_problems "${dir}")"
    if [[ -z "${problems}" ]]; then
      [[ -z "$(cd / && "${git[@]}" -C "${dir}" status --porcelain 2>/dev/null | head -1)" ]] ||
        problems="${dir}: files differ from the checked-out commit (git status)"
      [[ -z "$(cd / && "${git[@]}" -C "${dir}" rev-list -1 HEAD --not --remotes --tags 2>/dev/null)" ]] ||
        problems="${problems:+${problems}$'\n'}${dir}: has commits that are not upstream"
    fi
    [[ -n "${problems}" ]] || continue
    found=1
    while IFS= read -r dir; do log "WARNING: ${dir}"; done <<<"${problems}"
  done < <(brewau_repos)
  if [[ ${found} -eq 1 ]]; then
    log "WARNING: _brewau runs this code as root. Unless you made these changes, reset to upstream:"
    log "  sudo -u ${BREWAU_USER} /opt/homebrew/bin/brew update-reset   (discards local changes)"
  fi
  return 0
}

protect_cask_apps() {
  local json
  if json="$(installed_casks_json)"; then
    brewau_protect_apps "${json}" >/dev/null ||
      log "WARNING: some cask apps could not be protected; brew refuses to upgrade or remove those casks until they are"
    brewau_record_apps "${json}"
    rm -f "${json}"
  else
    log "WARNING: could not list installed casks; apps in /Applications were not checked"
  fi
}

write_sudoers() {
  local tmp
  tmp="$(mktemp /tmp/brewau-sudoers.XXXXXX)"
  cat >"${tmp}" <<EOF
# Managed by brewau. Regenerate with: sudo brewau reload
# Never hand the caller's PATH to anything running as ${BREWAU_USER}.
Defaults>${BREWAU_USER} secure_path="/usr/bin:/bin:/usr/sbin:/sbin"
# _brewau runs Homebrew; Homebrew elevates some cask steps with sudo -E.
${BREWAU_USER} ALL=(root) NOPASSWD: ALL
# Members of ${BREWAU_USERS_GROUP} may run brew, but only through the policy.
%${BREWAU_USERS_GROUP} ALL=(${BREWAU_USER}) NOPASSWD: ${BREWAU_LIBEXEC}/brew-policy
%${BREWAU_USERS_GROUP} ALL=(root) NOPASSWD: /bin/launchctl kickstart system/${BREWAU_LABEL}
EOF
  if ! visudo -cqf "${tmp}"; then
    rm -f "${tmp}"
    brewau_die "generated sudoers file failed validation; not installed"
  fi
  install -o root -g wheel -m 0440 "${tmp}" "${BREWAU_SUDOERS}"
  rm -f "${tmp}"
}

# Prints brew.env without the brewau block.
brew_env_without_block() {
  [[ -f "${BREWAU_BREW_ENV}" ]] || return 0
  awk -v begin="${BREWAU_BREW_ENV_BEGIN}" -v end="${BREWAU_BREW_ENV_END}" \
    '$0 == begin { skip = 1; next } $0 == end { skip = 0; next } !skip' "${BREWAU_BREW_ENV}"
}

# Homebrew reads the prefix and user brew.env files after the environment the
# policy sets, so they could override its HOMEBREW_* settings. The
# system-wide file takes priority over both when it says so.
write_brew_env() {
  local tmp
  tmp="$(mktemp /tmp/brewau-brewenv.XXXXXX)"
  brew_env_without_block >"${tmp}"
  brewau_brew_env_block >>"${tmp}"
  install -d -o root -g wheel -m 0755 "$(dirname "${BREWAU_BREW_ENV}")"
  install -o root -g wheel -m 0644 "${tmp}" "${BREWAU_BREW_ENV}"
  rm -f "${tmp}"
}

remove_brew_env() {
  [[ -f "${BREWAU_BREW_ENV}" ]] || return 0
  local tmp
  tmp="$(mktemp /tmp/brewau-brewenv.XXXXXX)"
  brew_env_without_block >"${tmp}"
  if grep -q '[^[:space:]]' "${tmp}"; then
    install -o root -g wheel -m 0644 "${tmp}" "${BREWAU_BREW_ENV}"
  else
    rm -f "${BREWAU_BREW_ENV}"
    rmdir "$(dirname "${BREWAU_BREW_ENV}")" 2>/dev/null || true
  fi
  rm -f "${tmp}"
}

write_launchdaemon() {
  local tmp="${BREWAU_PLIST}.tmp" i schedule=""
  # brewau_load_config has validated UPGRADE_HOUR and UPGRADE_MINUTE. With
  # AUTO_UPGRADE=0 the job has no schedule but `brewau run` still starts it.
  if [[ "${AUTO_UPGRADE}" == "1" ]]; then
    schedule="  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>$((10#${UPGRADE_HOUR}))</integer>
    <key>Minute</key>
    <integer>$((10#${UPGRADE_MINUTE}))</integer>
  </dict>"
  fi
  cat >"${tmp}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${BREWAU_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${BREWAU_LIBEXEC}/brewau-upgrade</string>
  </array>
  <key>UserName</key>
  <string>${BREWAU_USER}</string>
  <key>GroupName</key>
  <string>${BREWAU_GROUP}</string>
${schedule}
  <key>StandardOutPath</key>
  <string>${BREWAU_LOG_DIR}/upgrade.log</string>
  <key>StandardErrorPath</key>
  <string>${BREWAU_LOG_DIR}/upgrade.log</string>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
EOF
  plutil -lint -s "${tmp}" || brewau_die "generated LaunchDaemon plist is invalid"
  chown root:wheel "${tmp}"
  chmod 0644 "${tmp}"

  # Reloading kills a running upgrade, so leave an unchanged daemon alone.
  if [[ -f "${BREWAU_PLIST}" ]] && cmp -s "${tmp}" "${BREWAU_PLIST}" && brewau_daemon_loaded; then
    rm -f "${tmp}"
    return 0
  fi

  if brewau_daemon_loaded; then
    launchctl bootout "system/${BREWAU_LABEL}" 2>/dev/null || true
    # bootout returns before the job is gone, and bootstrap fails until it is.
    for ((i = 0; i < 50; i++)); do
      brewau_daemon_loaded || break
      sleep 0.2
    done
  fi
  mv -f "${tmp}" "${BREWAU_PLIST}"
  for ((i = 0; i < 5; i++)); do
    if launchctl bootstrap system "${BREWAU_PLIST}" 2>/dev/null; then
      if [[ -n "${schedule}" ]]; then
        log "scheduled daily upgrade at $(printf '%02d:%02d' "$((10#${UPGRADE_HOUR}))" "$((10#${UPGRADE_MINUTE}))")"
      else
        log "scheduled upgrades are off (AUTO_UPGRADE=0); start one with: brewau run"
      fi
      return 0
    fi
    sleep 1
  done
  launchctl bootstrap system "${BREWAU_PLIST}" || brewau_die "could not load ${BREWAU_PLIST}"
}

write_system_files() {
  echo "${BREWAU_ROOT}/bin" >"${BREWAU_PATHS_D}"
  chmod 0644 "${BREWAU_PATHS_D}"
  cat >"${NEWSYSLOG_CONF}" <<EOF
# logfilename                          [owner:group]    mode count size(KB) when flags
${BREWAU_LOG_DIR}/upgrade.log    ${BREWAU_USER}:${BREWAU_GROUP} 644  5     1024     *    NJ
${BREWAU_AUDIT_LOG}      ${BREWAU_USER}:${BREWAU_GROUP} 644  5     1024     *    NJ
EOF
  chmod 0644 "${NEWSYSLOG_CONF}"
}

cmd_reload() {
  require_root
  brewau_load_config
  write_sudoers
  write_brew_env
  write_launchdaemon
}

cmd_install() {
  require_root
  [[ -x "${HOMEBREW_BIN}" ]] ||
    brewau_die "Homebrew was not found at ${HOMEBREW_PREFIX_PATH}. Install Homebrew first: https://brew.sh"

  # Earlier versions did not write the marker, but a finished install always
  # left original-owner and sudoers; original-owner alone means an earlier
  # first install failed part-way.
  local first_install=1
  [[ -f "${INSTALLED_MARKER}" || (-f "${ORIGINAL_OWNER_FILE}" && -f "${BREWAU_SUDOERS}") ]] && first_install=0

  ensure_service_account
  ensure_users_group
  ensure_dirs
  ensure_config
  brewau_load_config

  local user users=("$@")
  if [[ ${#users[@]} -eq 0 && ${first_install} -eq 1 ]]; then
    user="$(console_user)"
    [[ -n "${user}" ]] && users+=("${user}")
    users+=("$(stat -f%Su "${HOMEBREW_PREFIX_PATH}")")
  fi

  take_over_prefix
  check_repos
  local granted=" "
  for user in ${users[@]+"${users[@]}"}; do
    [[ "${user}" == "${BREWAU_USER}" || "${user}" == "root" ]] && continue
    [[ "${granted}" == *" ${user} "* ]] && continue
    allow_user "${user}"
    granted="${granted}${user} "
  done

  write_system_files
  write_sudoers
  write_brew_env
  # Only the first install takes apps as they are; `repair` must not quietly
  # accept one that was swapped since.
  BREWAU_APPS_BASELINE="${first_install}"
  protect_cask_apps
  BREWAU_APPS_BASELINE=0
  write_launchdaemon
  dscacheutil -flushcache 2>/dev/null || true
  touch "${INSTALLED_MARKER}"

  log "installed. Open a new terminal; \`brew\` now runs through brewau."
  log "if your shell profile runs \`/opt/homebrew/bin/brew shellenv\`, run \`/opt/brewau/bin/brewau setup-shell\`."
}

# Undoes `brewau setup-shell` for every local user, running as that user so
# file ownership is kept, and hands back services whose files brewau moved.
restore_users() {
  local owner="$1" user uid home
  while read -r user uid; do
    [[ "${uid}" -ge 500 ]] || continue
    home="$(user_home "${user}")" || continue
    (cd / && sudo -u "${user}" -H /bin/bash -p "${BREWAU_ROOT}/bin/brewau" restore-shell </dev/null) ||
      log "WARNING: could not restore the shell profile of ${user}"
    restore_services "${user}" "${home}" "${owner}"
  done < <(dscl . -list /Users UniqueID)
}

user_home() {
  local home
  home="$(dscl . -read "/Users/$1" NFSHomeDirectory 2>/dev/null | awk '{print $2}')"
  [[ -n "${home}" && -d "${home}" ]] && echo "${home}"
}

# Services that ran as a user had their files moved out of the prefix, and
# the next `brew services start` or `restart` without brewau points them back
# at it. For the prefix owner, whose services keep working there, stopped
# services get their data copied back and their agent pointed at it again
# (the user's copy stays where it was). Running services and other users'
# are named. Which directories hold data comes from the keg, not from the
# user's own plist.
restore_services() {
  local user="$1" home="$2" owner="$3" plist formula userdir uservar rel ok rels
  userdir="${home}/Library/Application Support/brewau"
  uservar="${userdir}/var"
  for plist in "${home}"/Library/LaunchAgents/sh.brew.*.plist "${home}"/Library/LaunchAgents/homebrew.mxcl.*.plist; do
    formula="$(brewau_service_formula "${plist}")" || continue
    sudo -u "${user}" grep -qF "${uservar}" "${plist}" 2>/dev/null || continue
    ok=0
    if [[ "${user}" == "${owner}" ]] && rels="$(brewau_service_var_dirs "${formula}")" &&
      ! brewau_service_loaded "gui/$(id -u "${user}")" "${formula}"; then
      ok=1
      while IFS= read -r rel; do
        [[ -n "${rel}" ]] && sudo -u "${user}" /bin/test -d "${uservar}${rel}" || continue
        copy_from_user "${user}" "${uservar}${rel}" "${HOMEBREW_PREFIX_PATH}/var${rel}" || ok=0
      done <<<"${rels}"
    fi
    # Back to the prefix's var directory and the prefix's config files.
    if [[ ${ok} -eq 1 ]] && sudo -u "${user}" /bin/bash -p -c \
      'source "$1" && brewau_rewrite_file "$2" brewau_replace_literal "$3/var" "$4/var" &&
        brewau_rewrite_file "$2" brewau_replace_literal "$3/etc/" "$4/etc/"' \
      brewau "${BREWAU_LIBEXEC}/common.sh" "${plist}" "${userdir}" "${HOMEBREW_PREFIX_PATH}"; then
      log "${user}'s service ${formula} uses ${HOMEBREW_PREFIX_PATH}/var again (its old files stay in ${uservar})"
    else
      log "WARNING: ${user}'s service ${formula} keeps its files in ${uservar}."
      log "  The next \`brew services start/restart ${formula}\` uses ${HOMEBREW_PREFIX_PATH}/var again; move its data there first."
    fi
  done
}

# Copies directory $2, which only root can read, into $3 in user $1's home.
# The copy is made in a private directory and moved into place as the user,
# so root never writes where the user could redirect it.
copy_into_user() {
  local user="$1" src="$2" dest="$3" tmp result=0
  [[ -d "${src}" && ! -L "${src}" ]] || return 1
  tmp="$(mktemp -d /private/tmp/brewau-copy.XXXXXX)" || return 1
  if ditto --noacl "${src}" "${tmp}/data" && chown -R "${user}:$(id -gn "${user}")" "${tmp}/data" && chown "${user}" "${tmp}" &&
    sudo -u "${user}" /bin/bash -p -c '[[ ! -e "$2" ]] && mkdir -p "${2%/*}" && mv "$1" "$2"' brewau "${tmp}/data" "${dest}"; then
    log "copied ${src} to ${dest}"
  else
    log "WARNING: could not copy ${src} to ${dest} (does it exist already?)"
    result=1
  fi
  sudo -u "${user}" /bin/rm -rf "${tmp}" 2>/dev/null || true
  return "${result}"
}

# Copies user $1's directory $2 to $3 in the prefix, which still belongs to
# _brewau. The user does the reading, into a directory of theirs inside one of
# root's (so they cannot swap it for a symlink), so root never follows their
# paths; root then takes that directory back and the copy over, as it does an
# app (brewau_lock_tree), before it goes into the prefix.
copy_from_user() {
  local user="$1" src="$2" dest="$3" parent work result=1
  [[ ! -e "${dest}" && ! -L "${dest}" ]] || { log "WARNING: ${dest} exists; leaving ${src} where it is"; return 1; }
  parent="$(mktemp -d /private/tmp/brewau-copy.XXXXXX)" || return 1
  work="${parent}/work"
  if chmod 0755 "${parent}" && mkdir "${work}" && chown "${user}" "${work}" &&
    sudo -u "${user}" /usr/bin/ditto --noacl "${src}" "${work}/data" 2>/dev/null &&
    chown -h root "${work}" && chmod -h 0700 "${work}" &&
    [[ -d "${work}/data" && ! -L "${work}/data" ]] && brewau_lock_tree "${work}/data" &&
    # A hard link to one of root's files would hand it to the prefix owner.
    [[ -z "$(find "${work}/data" ! -type d -links +1 ! -user "${BREWAU_USER}" -print | head -1)" ]] &&
    mkdir -p "${dest%/*}" && mv "${work}/data" "${dest}"; then
    log "copied ${src} to ${dest}"
    result=0
  else
    log "WARNING: could not copy ${src} to ${dest}"
  fi
  # Until root took it back, the user could put anything in it.
  if [[ -d "${work}" && "$(stat -f %Su "${work}")" == "${user}" ]]; then
    sudo -u "${user}" /bin/rm -rf "${work}" 2>/dev/null || true
  fi
  rm -rf "${parent}"
  return "${result}"
}

# Copies the data a service (formula $2) had in the prefix from before brewau
# to where it looks for it when user $1 runs it. Which directories hold data
# comes from the keg. The data is whoever ran the service before; the
# administrator decides who gets it.
cmd_move_service_data() {
  require_root
  local user="$1" formula="$2" home uservar rels rel src var copied=0
  id "${user}" >/dev/null 2>&1 || brewau_die "no such user: ${user}"
  [[ "${formula}" =~ ^[A-Za-z0-9][A-Za-z0-9@._+-]*$ ]] || brewau_die "not a formula name: ${formula}"
  home="$(user_home "${user}")" || brewau_die "${user} has no home directory"
  uservar="${home}/Library/Application Support/brewau/var"
  rels="$(brewau_service_var_dirs "${formula}")" || brewau_die "${formula} is not installed or has no service"
  ! brewau_service_loaded "gui/$(id -u "${user}")" "${formula}" ||
    brewau_die "${formula} is running; ${user} has to stop it first: brew services stop ${formula}"
  var="$(cd -P "${HOMEBREW_PREFIX_PATH}/var" && pwd -P)"
  while IFS= read -r rel; do
    src="${HOMEBREW_PREFIX_PATH}/var${rel}"
    [[ -n "${rel}" && -d "${src}" && ! -L "${src}" ]] || continue
    [[ "$(cd -P "${src}" && pwd -P)" == "${var}"/* ]] || continue
    copy_into_user "${user}" "${src}" "${uservar}${rel}" && copied=1
  done <<<"${rels}"
  [[ ${copied} -eq 1 ]] || brewau_die "found no data of ${formula} to copy"
  log "${user} can start it again with: brew services start ${formula}"
}

# An administrator vouches for app $1 after checking it: it is locked, its
# current signature becomes brewau's record, and brew runs its cask's steps
# again. For an app that is gone, brewau just forgets it.
cmd_trust_app() {
  require_root
  local app="${1%/}" state team
  [[ "${app}" == "${BREWAU_APPDIR}"/*.app && "${app}" != *..* ]] || brewau_die "not an app in ${BREWAU_APPDIR}: ${app}"
  state="$(brewau_app_state "${app}")"
  if [[ ! -e "${app}" && ! -L "${app}" ]]; then
    rm -f "${state}.untrusted" "${state}.team"
    log "forgot ${app}"
    return 0
  fi
  [[ -d "${app}" && ! -L "${app}" ]] || brewau_die "${app} is not an app bundle"
  brewau_lock_app "${app}" || brewau_die "could not lock ${app} (App Management permission?)"
  rm -f "${state}.untrusted" "${state}.team"
  brewau_record_app "${app}" || brewau_die "could not record the signature of ${app}"
  team="$(cut -f 2 "${state}.team" 2>/dev/null)"
  if [[ "${team}" == "-" ]]; then
    log "trusting ${app}, which has no valid Developer ID signature"
  else
    log "trusting ${app}, signed by Team ID ${team}"
  fi
}

# Ends every process running as _brewau, e.g. a brew command a user started
# before the sudoers rule was removed.
stop_service_processes() {
  local i
  id "${BREWAU_USER}" >/dev/null 2>&1 || return 0
  pkill -TERM -u "${BREWAU_USER}" 2>/dev/null || return 0
  for ((i = 0; i < 50; i++)); do
    pgrep -u "${BREWAU_USER}" >/dev/null 2>&1 || return 0
    sleep 0.2
  done
  pkill -KILL -u "${BREWAU_USER}" 2>/dev/null || true
}

# Gives apps that brewau installed back to the user who will own the prefix.
# Depth-first, so a directory changes hands only after everything in it and
# the new owner never controls a path root still has to walk.
return_cask_apps() {
  local owner="$1" json app
  json="$(installed_casks_json)" || {
    log "WARNING: could not list installed casks; apps owned by ${BREWAU_USER} stay that way"
    return 0
  }
  while IFS= read -r app; do
    find -d "${app}" -user "${BREWAU_USER}" -exec chown -h "${owner}:admin" {} + 2>/dev/null ||
      log "WARNING: could not return ${app} to ${owner}"
  done < <(brewau_cask_app_paths "${json}")
  rm -f "${json}"
}

# Runs while the prefix still belongs to _brewau, so nobody can swap a path
# for a symlink before root changes its mode.
restore_prefix_modes() {
  [[ -f "${ORIGINAL_MODES_FILE}" ]] || return 0
  local line mode path
  while IFS= read -r line; do
    mode="${line%% *}"
    path="${line#* }"
    [[ "${mode}" =~ ^[0-7]{3,4}$ && "${path}" == "${HOMEBREW_PREFIX_PATH}"/* ]] || continue
    [[ "${path}/" != */./* && "${path}/" != */../* ]] || continue
    [[ -e "${path}" && ! -L "${path}" ]] && { chmod -h "${mode}" "${path}" 2>/dev/null || true; }
  done <"${ORIGINAL_MODES_FILE}"
  return 0
}

# Formulae that run as Homebrew system daemons (root LaunchDaemons).
system_service_names() {
  local plist
  for plist in /Library/LaunchDaemons/sh.brew.*.plist /Library/LaunchDaemons/homebrew.mxcl.*.plist; do
    [[ -f "${plist}" ]] || continue
    brewau_service_formula "${plist}" || true
  done | sort -u
}

# Hands the prefix to its original owner. Everything inside a directory
# changes hands before the directory itself, so the owner never controls a
# directory root still has to walk. Kegs of system daemons go to root
# instead, as `sudo brew services start` leaves them. That protects only the
# keg (the owner controls the rest of the prefix, opt/ links included), so a
# non-admin owner gets a warning.
return_prefix() {
  local owner="$1" services keg name
  services="$(system_service_names)"
  while IFS= read -r -d '' keg; do
    name="${keg##*/}"
    if brewau_in_words "${name}" "${services}"; then
      # Restored modes may have brought back group/world write.
      chown -hR root:admin "${keg}"
      chmod -R go-w "${keg}"
      log "${name} runs as a root system daemon, so its keg stays owned by root (upgrade or remove it with sudo)"
    else
      chown -hR "${owner}:admin" "${keg}"
    fi
  done < <(find "${HOMEBREW_PREFIX_PATH}/Cellar" -mindepth 1 -maxdepth 1 -print0 2>/dev/null)
  find "${HOMEBREW_PREFIX_PATH}" -mindepth 1 -maxdepth 1 ! -name Cellar -exec chown -hR "${owner}:admin" {} +
  [[ -d "${HOMEBREW_PREFIX_PATH}/Cellar" ]] && chown -h "${owner}:admin" "${HOMEBREW_PREFIX_PATH}/Cellar"
  chown -h "${owner}:admin" "${HOMEBREW_PREFIX_PATH}"
  if [[ -n "${services}" ]] && ! dseditgroup -o checkmember -m "${owner}" admin >/dev/null 2>&1; then
    log "WARNING: ${owner} is not an administrator but owns ${HOMEBREW_PREFIX_PATH}, which root system daemons run from"
    log "  (${services//$'\n'/ }). Stop them unless ${owner} is trusted with root: sudo brew services stop <formula>"
  fi
}

cmd_uninstall() {
  require_root
  local owner=""
  [[ -f "${ORIGINAL_OWNER_FILE}" ]] && owner="$(cat "${ORIGINAL_OWNER_FILE}")"
  [[ -z "${owner}" ]] && owner="$(console_user)"

  # Close every way into ${BREWAU_USER} (and so root) before the prefix becomes
  # user-writable again; otherwise a user could edit Homebrew's code and run
  # it through the still-valid policy rule.
  launchctl bootout "system/${BREWAU_LABEL}" 2>/dev/null || true
  rm -f "${BREWAU_SUDOERS}"
  stop_service_processes
  # While the prefix still belongs to _brewau, so copies into it are safe.
  restore_users "${owner}"

  if [[ -n "${owner}" ]] && id "${owner}" >/dev/null 2>&1 && [[ -d "${HOMEBREW_PREFIX_PATH}" ]]; then
    return_cask_apps "${owner}"
    restore_prefix_modes
    log "returning ${HOMEBREW_PREFIX_PATH} to ${owner}"
    return_prefix "${owner}"
  else
    log "WARNING: could not determine original owner; ${HOMEBREW_PREFIX_PATH} is still owned by ${BREWAU_USER}"
    log "fix with: sudo chown -hR <you>:admin ${HOMEBREW_PREFIX_PATH}"
  fi

  rm -f "${BREWAU_PLIST}" "${BREWAU_PATHS_D}" "${NEWSYSLOG_CONF}"
  remove_brew_env
  dscl . -delete "/Users/${BREWAU_USER}" 2>/dev/null || true
  dscl . -delete "/Groups/${BREWAU_GROUP}" 2>/dev/null || true
  dseditgroup -o delete "${BREWAU_USERS_GROUP}" 2>/dev/null || true
  rm -rf "${BREWAU_ROOT}"
  pkgutil --forget "${PKG_ID}" >/dev/null 2>&1 || true
  dscacheutil -flushcache 2>/dev/null || true
  log "uninstalled. Homebrew at ${HOMEBREW_PREFIX_PATH} is vanilla again."
}

main() {
  case "${1:-}" in
    install) shift; cmd_install "$@" ;;
    reload) cmd_reload ;;
    allow-user) require_root; allow_user "${2:?user required}" ;;
    deny-user) require_root; deny_user "${2:?user required}" ;;
    uninstall) cmd_uninstall ;;
    trust-app) cmd_trust_app "${2:?app required}" ;;
    move-service-data) cmd_move_service_data "${2:?user required}" "${3:?formula required}" ;;
    *) brewau_die "usage: brewau-setup install|reload|allow-user|deny-user|uninstall|trust-app|move-service-data" ;;
  esac
}

if [[ -z "${BREWAU_SETUP_TEST:-}" ]]; then
  main "$@"
fi
