# brewau configuration. Owned by root; edit with `sudo brewau config`, or change
# one setting with e.g. `sudo brewau config add ALLOWED_TAPS openai/tools`.
# Lists are separated by spaces, not commas: "one/tap other/tap".
# This file is parsed, never executed.

# Third-party taps users may install from, as user/repo. Official homebrew/*
# taps are always allowed. Anything you list here is trusted with root, and
# brewau runs `brew trust` for it (Homebrew 7 and later).
ALLOWED_TAPS=""

# Packages nobody may install (passed to HOMEBREW_FORBIDDEN_*).
FORBIDDEN_FORMULAE=""
FORBIDDEN_CASKS=""

# Additional brew options (flags starting with -) to allow beyond the built-in
# allowlist, e.g. "--no-binaries --foo". Not subcommands.
EXTRA_ALLOWED_OPTIONS=""

# Formulae whose `brew services` run as root system daemons (LaunchDaemons),
# e.g. "tailscale". Anything listed runs as root, so only list services that
# need it. Other services run as the user who starts them.
ALLOWED_SERVICES=""

# Scheduled unattended upgrades. Run `sudo brewau reload` after changing the time.
AUTO_UPGRADE="1"
# Also upgrade casks that update themselves (Chrome, Slack, ...).
UPGRADE_GREEDY="1"
# Formulae/casks the scheduled job must never upgrade, with or without their tap.
UPGRADE_EXCLUDE=""
UPGRADE_HOUR="4"
UPGRADE_MINUTE="0"

# Independent scans and upgrade scheduling. Times are minutes since midnight;
# an empty UPGRADE_TIMES uses UPGRADE_HOUR / UPGRADE_MINUTE for compatibility.
SCAN_MINUTES="60"
UPDATE_HOMEBREW="1"
UPGRADE_MODE="daily"
UPGRADE_INTERVAL_HOURS="1"
# Sunday=1, Monday=2, ..., Saturday=7.
UPGRADE_WEEKDAY="2"
# For daily at 03:00 and 15:00: "180 900".
UPGRADE_TIMES=""

# Remove cached downloads older than this many days (or all).
CLEANUP_PRUNE_DAYS="1"
