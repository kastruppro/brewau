# brewau configuration. Owned by root; edit with `sudo brewau config`.
# Values are space-separated lists. This file is parsed, never executed.

# Third-party taps users may install from, as user/repo. Official homebrew/*
# taps are always allowed. Anything you list here is trusted with root.
ALLOWED_TAPS=""

# Packages nobody may install (passed to HOMEBREW_FORBIDDEN_*).
FORBIDDEN_FORMULAE=""
FORBIDDEN_CASKS=""

# Additional brew options to allow beyond the built-in allowlist, e.g. "--no-binaries".
EXTRA_ALLOWED_OPTIONS=""

# Formulae whose `brew services` run as root system daemons (LaunchDaemons),
# e.g. "tailscale". Anything listed runs as root, so only list services that
# need it. Other services run as the user who starts them.
ALLOWED_SERVICES=""

# Scheduled unattended upgrades. Run `sudo brewau reload` after changing the time.
AUTO_UPGRADE="1"
# Also upgrade casks that update themselves (Chrome, Slack, ...).
UPGRADE_GREEDY="1"
# Formulae/casks the scheduled job must never upgrade.
UPGRADE_EXCLUDE=""
UPGRADE_HOUR="4"
UPGRADE_MINUTE="0"
