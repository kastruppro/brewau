#!/bin/bash -p
# brewau: status and administration for the brewau Homebrew isolation layer.

set -u

# Keep the user's PATH only for `doctor` and the editor in `config`.
USER_PATH="${PATH:-}"
# Never trust the caller's PATH: sudo passes it through, so a program planted
# in it would run with this script's privileges.
PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

BREWAU_LIBEXEC="/opt/brewau/libexec"
# shellcheck source=../libexec/common.sh
source "${BREWAU_LIBEXEC}/common.sh"

VERSION="$(cat "${BREWAU_ROOT}/share/VERSION" 2>/dev/null || echo unknown)"

usage() {
  cat <<EOF
brewau ${VERSION} - unattended, isolated Homebrew

Usage: brewau <command>

  status              show schedule, last run and access
  run                 start the scheduled upgrade now
  scan                refresh the update list without installing anything
  log [-f] [--audit]  show the upgrade log (or the brew audit log)
  doctor              check that the installation is healthy
  setup-shell         point your shell profile at the brewau wrapper
  restore-shell       undo setup-shell (uninstall does this for every user)

Administrator commands (run with sudo):
  config              edit ${BREWAU_CONF} and apply it
  reload              re-apply brewau.conf (schedule, sudoers, brew.env)
  repair              re-apply ownership, permissions and system files
  allow-user <user>   allow a user to run brew
  deny-user <user>    revoke a user's access to brew
  trust-app <app>     trust a cask app again after checking it (see brewau doctor)
  move-service-data <user> <formula>
                      copy a service's data from before brewau to where it now runs
  uninstall           remove brewau and return Homebrew to its original owner
EOF
}

ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$*"; FAILED=1; }

in_users_group() {
  case " $(id -Gn "${1:-$(id -un)}" 2>/dev/null) " in *" ${BREWAU_USERS_GROUP} "*) return 0 ;; esac
  return 1
}

cmd_status() {
  brewau_load_config
  echo "brewau ${VERSION}"
  if [[ -x "${BREWAU_LIBEXEC}/brewau-agent" && "${AUTO_UPGRADE}" == "1" && "${UPGRADE_MODE}" == "interval" ]]; then
    echo "Schedule:   every ${UPGRADE_INTERVAL_HOURS} hour(s)"
  elif [[ "${AUTO_UPGRADE}" == "1" && -n "${UPGRADE_TIMES}" ]]; then
    echo "Schedule:   ${UPGRADE_MODE}, minute(s) of day: ${UPGRADE_TIMES} (weekday ${UPGRADE_WEEKDAY}; Sunday=1)"
  elif [[ "${AUTO_UPGRADE}" == "1" ]]; then
    printf 'Schedule:   daily at %02d:%02d%s\n' "$((10#${UPGRADE_HOUR}))" "$((10#${UPGRADE_MINUTE}))" \
      "$([[ "${UPGRADE_GREEDY}" == "1" ]] && echo " (including self-updating casks)")"
  else
    echo "Schedule:   disabled (AUTO_UPGRADE=0); start one by hand with: brewau run"
  fi
  if [[ -r "${BREWAU_STATE_DIR}/last-run" ]]; then
    local finished status upgraded
    finished="$(sed -n 's/^finished=//p' "${BREWAU_STATE_DIR}/last-run")"
    status="$(sed -n 's/^status=//p' "${BREWAU_STATE_DIR}/last-run")"
    upgraded="$(sed -n 's/^upgraded=//p' "${BREWAU_STATE_DIR}/last-run")"
    echo "Last run:   ${finished} (${status})"
    echo "Upgraded:   ${upgraded:-nothing}"
  else
    echo "Last run:   never"
  fi
  echo "Taps:       homebrew/* ${ALLOWED_TAPS}"
  echo "Scanning:   every ${SCAN_MINUTES} minutes"
  if in_users_group; then
    echo "Access:     $(id -un) may use brew"
  else
    echo "Access:     $(id -un) may NOT use brew"
  fi
}

cmd_run() {
  local err label="${1:-${BREWAU_LABEL}}"
  in_users_group || brewau_die "$(id -un) is not in ${BREWAU_USERS_GROUP}; ask an administrator to run: sudo brewau allow-user $(id -un)"
  if ! err="$(/usr/bin/sudo -n /bin/launchctl kickstart "system/${label}" 2>&1)"; then
    brewau_daemon_loaded || brewau_die "the upgrade daemon is not loaded; run: sudo brewau reload"
    brewau_die "could not start the upgrade: ${err:-launchctl failed}"
  fi
  echo "Upgrade started. Follow it with: brewau log -f"
}

cmd_log() {
  local file="${BREWAU_LOG_DIR}/upgrade.log" follow=0 arg
  for arg in "$@"; do
    case "${arg}" in
      -f) follow=1 ;;
      --audit) file="${BREWAU_AUDIT_LOG}" ;;
      *) brewau_die "unknown option ${arg}" ;;
    esac
  done
  [[ -r "${file}" ]] || brewau_die "no log yet at ${file}"
  if [[ ${follow} -eq 1 ]]; then
    exec tail -n 50 -f "${file}"
  fi
  exec tail -n 100 "${file}"
}

cmd_doctor() {
  FAILED=0
  local brew_path owner writable
  brew_path="$(PATH="${USER_PATH}" command -v brew || true)"
  if [[ "${brew_path}" == "${BREWAU_ROOT}/bin/brew" ]]; then
    ok "brew in PATH is the brewau wrapper"
  else
    bad "brew in PATH is ${brew_path:-missing}; run: brewau setup-shell (then open a new terminal)"
  fi

  owner="$(stat -f%Su "${HOMEBREW_PREFIX_PATH}" 2>/dev/null || true)"
  if [[ "${owner}" == "${BREWAU_USER}" ]]; then
    ok "${HOMEBREW_PREFIX_PATH} is owned by ${BREWAU_USER}"
  else
    bad "${HOMEBREW_PREFIX_PATH} is owned by ${owner:-nobody}; run: sudo brewau repair"
  fi

  writable="$(find "${HOMEBREW_PREFIX_PATH}" -maxdepth 3 ! -type l \( -perm -g+w -o -perm -o+w -o -acl \) 2>/dev/null | head -1)"
  if [[ -z "${writable}" ]]; then
    ok "no group/world-writable or ACL'd paths in ${HOMEBREW_PREFIX_PATH}"
  else
    bad "${writable} is group/world-writable or has an ACL; run: sudo brewau repair"
  fi

  brewau_load_config

  local env_file
  for env_file in "${HOMEBREW_PREFIX_PATH}/etc/homebrew/brew.env" "${BREWAU_HOME}/.homebrew/brew.env"; do
    [[ -f "${env_file}" ]] && echo "  - ${env_file} exists; settings in it that brewau does not enforce still apply, review it"
  done
  # Homebrew applies brew.env over the policy's environment, so a block left
  # from an older brewau.conf is what counts.
  if [[ "$(brewau_brew_env_current)" == "$(brewau_brew_env_block)" ]]; then
    ok "${BREWAU_BREW_ENV} enforces brewau.conf"
  else
    bad "${BREWAU_BREW_ENV} does not match brewau.conf; run: sudo brewau reload"
  fi

  [[ -f "${BREWAU_SUDOERS}" ]] && ok "sudoers rule installed" || bad "${BREWAU_SUDOERS} is missing; run: sudo brewau repair"
  brewau_daemon_loaded && ok "upgrade daemon is loaded" || bad "upgrade daemon is not loaded; run: sudo brewau reload"
  in_users_group && ok "$(id -un) is in ${BREWAU_USERS_GROUP}" ||
    bad "$(id -un) is not in ${BREWAU_USERS_GROUP}; run: sudo brewau allow-user $(id -un)"

  # The previous owner of the prefix, or anyone who could write to it, could
  # have made git run commands as _brewau.
  local dir problem repos_ok=1
  while IFS= read -r dir; do
    while IFS= read -r problem; do
      [[ -n "${problem}" ]] || continue
      bad "${problem}; review it (git runs it as ${BREWAU_USER})"
      repos_ok=0
    done < <(brewau_repo_problems "${dir}")
  done < <(brewau_repos)
  [[ ${repos_ok} -eq 0 ]] || ok "Homebrew's repository and taps have no git config or hooks that run commands"

  local marker
  for marker in "${BREWAU_APP_STATE_DIR}"/*.untrusted; do
    [[ -f "${marker}" ]] || continue
    bad "$(cat "${marker}") may have been changed by someone else; check it, then: sudo brewau trust-app '$(cat "${marker}")'"
  done

  local forbidden
  forbidden="$(brewau_forbidden_taps)"
  [[ -n "${forbidden}" ]] &&
    echo "  - installed taps outside ALLOWED_TAPS (blocked): ${forbidden}"

  local last_run="${BREWAU_STATE_DIR}/last-run" finished since age stale_seconds=$((48 * 3600))
  [[ "${UPGRADE_MODE}" == "weekly" ]] && stale_seconds=$((8 * 86400))
  if [[ "${AUTO_UPGRADE}" == "1" && -r "${last_run}" ]]; then
    if grep -q '^status=ok' "${last_run}"; then
      ok "last scheduled run succeeded"
    else
      bad "last scheduled run failed; see: brewau log"
    fi
    finished="$(sed -n 's/^finished=//p' "${last_run}")"
    if since="$(date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "${finished}" +%s 2>/dev/null)"; then
      age=$(($(date +%s) - since))
      if [[ ${age} -gt ${stale_seconds} ]]; then
        bad "no scheduled run for $((age / 86400)) days (the Mac is off at $(printf '%02d:%02d' "$((10#${UPGRADE_HOUR}))" "$((10#${UPGRADE_MINUTE}))")?); run: brewau run"
      fi
    else
      bad "${last_run} is unreadable; run: brewau run"
    fi
  elif [[ "${AUTO_UPGRADE}" == "1" ]]; then
    echo "  - no scheduled run yet; start one with: brewau run"
  fi

  if tail -n 500 "${BREWAU_LOG_DIR}/upgrade.log" 2>/dev/null |
    grep -Eq 'Operation not permitted|could not take ownership|could not protect|could not pin'; then
    bad "some apps could not be protected, usually because macOS App Management blocked it; allow it for the upgrade job, e.g. with an MDM Privacy Preferences (PPPC) profile; see: brewau log"
  fi
  return "${FAILED}"
}

SHELLENV_RE="(^|[^/[:alnum:]_])(${HOMEBREW_PREFIX_PATH}/bin/)?brew shellenv"
PATH_MARKER="# brewau: keep the wrapper first in PATH"
ZSH_BEGIN="# BEGIN brewau completions"
ZSH_END="# END brewau completions"

zsh_completions_block() {
  cat <<'EOF'
# BEGIN brewau completions
# Keep zsh's security checks; use root-owned copies of Homebrew completions.
fpath=(/opt/brewau/share/zsh/site-functions ${fpath:#/opt/homebrew/*})
# END brewau completions
EOF
}

setup_zsh_completions() {
  local file
  for file in "${HOME}/.zprofile" "${HOME}/.zshrc"; do
    [[ -f "${file}" ]] && backup_once "${file}"
    if ! grep -qF "${ZSH_BEGIN}" "${file}" 2>/dev/null; then
      touch "${file}"
      brewau_rewrite_file "${file}" prepend_zsh_completions || return 1
    fi
  done
}

prepend_zsh_completions() {
  zsh_completions_block
  cat
}

PROFILES=(.zprofile .zshrc .bash_profile .bashrc .profile .config/fish/config.fish)

backup_once() {
  [[ -f "$1.brewau-backup" ]] || cp -p "$1" "$1.brewau-backup"
}

cmd_setup_shell() {
  local file rc shell
  setup_zsh_completions || brewau_die "could not prepare zsh completions"
  # Point every `brew shellenv` (with or without the full path) at the wrapper.
  for file in "${PROFILES[@]/#/${HOME}/}"; do
    [[ -f "${file}" ]] || continue
    grep -Eq "${SHELLENV_RE}" "${file}" || continue
    backup_once "${file}"
    if brewau_rewrite_file "${file}" sed -E "s#${SHELLENV_RE}#\\1${BREWAU_ROOT}/bin/brew shellenv#g"; then
      echo "updated ${file} (backup: ${file}.brewau-backup)"
    else
      echo "brewau: could not update ${file}" >&2
    fi
  done

  # Profiles can also prepend /opt/homebrew/bin by hand, so finish the rc file
  # of the login shell by putting the wrapper first again.
  shell="$(basename "$(dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}')")"
  case "${shell}" in
    zsh) rc="${HOME}/.zshrc" ;;
    bash) rc="${HOME}/.bash_profile" ;;
    fish) rc="${HOME}/.config/fish/config.fish" ;;
    *) rc="" ;;
  esac
  if [[ -n "${rc}" ]] && ! grep -qF "${PATH_MARKER}" "${rc}" 2>/dev/null; then
    [[ -f "${rc}" ]] && backup_once "${rc}"
    mkdir -p "$(dirname "${rc}")"
    if [[ "${shell}" == "fish" ]]; then
      printf '\n%s\nfish_add_path --global --move --path %s\n' "${PATH_MARKER}" "${BREWAU_ROOT}/bin" >>"${rc}"
    else
      printf '\n%s\nexport PATH="%s:${PATH}"\n' "${PATH_MARKER}" "${BREWAU_ROOT}/bin" >>"${rc}"
    fi
    echo "added the wrapper to the end of ${rc}"
  fi

  echo "Open a new terminal, then run: brewau doctor"
}

# Undoes setup-shell: points `brew shellenv` back at Homebrew and removes the
# PATH lines it appended. Without this, profiles would call a wrapper that no
# longer exists after uninstall and lose Homebrew from PATH.
cmd_restore_shell() {
  local file
  for file in "${HOME}/.zprofile" "${HOME}/.zshrc"; do
    [[ -f "${file}" ]] || continue
    brewau_rewrite_file "${file}" awk -v begin="${ZSH_BEGIN}" -v end="${ZSH_END}" \
      '$0 == begin { skip = 1; next } $0 == end { skip = 0; next } !skip' || return 1
  done
  for file in "${PROFILES[@]/#/${HOME}/}"; do
    [[ -f "${file}" ]] || continue
    grep -qF -e "${BREWAU_ROOT}/bin" "${file}" || continue
    brewau_rewrite_file "${file}" awk -v marker="${PATH_MARKER}" \
      -v from="${BREWAU_ROOT}/bin/brew shellenv" -v to="${HOMEBREW_BIN} shellenv" '
        drop { drop = 0; next }
        $0 == marker { drop = 1; if (blank) blank = ""; next }
        {
          while ((i = index($0, from)) > 0)
            $0 = substr($0, 1, i - 1) to substr($0, i + length(from))
          if (blank) print ""
          if ($0 == "") { blank = 1; next }
          blank = ""
          print
        }
        END { if (blank) print "" }' || { echo "brewau: could not restore ${file}" >&2; continue; }
    echo "restored ${file}"
  done
}

cmd_config() {
  [[ "$(id -u)" -eq 0 ]] || brewau_die "run with sudo: sudo brewau config"
  local tmp answer
  tmp="$(mktemp /tmp/brewau-conf.XXXXXX)"
  cp "${BREWAU_CONF}" "${tmp}"
  # Edit a copy and only install it once it parses; a broken live config
  # makes every brew command fail.
  while true; do
    # The editor may carry arguments (e.g. "code --wait"), and lives in the
    # administrator's own PATH. macOS sudo keeps VISUAL and EDITOR.
    # shellcheck disable=SC2086
    PATH="${USER_PATH}" ${VISUAL:-${EDITOR:-vi}} "${tmp}"
    # Strict: unknown keys and invalid values are refused here rather than
    # ignored later.
    if (BREWAU_CONFIG_STRICT=1 brewau_load_config "${tmp}"); then
      break
    fi
    read -r -p "brewau: the configuration is invalid. Edit again? [Y/n] " answer
    if [[ "${answer}" == [nN]* ]]; then
      rm -f "${tmp}"
      brewau_die "no changes applied"
    fi
  done
  install -o root -g wheel -m 0644 "${tmp}" "${BREWAU_CONF}"
  rm -f "${tmp}"
  exec "${BREWAU_LIBEXEC}/brewau-setup" reload
}

root_command() {
  [[ "$(id -u)" -eq 0 ]] || brewau_die "run with sudo: sudo brewau $*"
  exec "${BREWAU_LIBEXEC}/brewau-setup" "$@"
}

case "${1:-}" in
  status) cmd_status ;;
  run) cmd_run ;;
  scan) cmd_run com.kastruppro.brewau.scan ;;
  log) shift; cmd_log "$@" ;;
  doctor) cmd_doctor ;;
  setup-shell) cmd_setup_shell ;;
  restore-shell) cmd_restore_shell ;;
  config) cmd_config ;;
  repair)
    [[ "$(id -u)" -eq 0 ]] || brewau_die "run with sudo: sudo brewau repair"
    root_command install
    ;;
  reload | allow-user | deny-user | uninstall | trust-app | move-service-data) root_command "$@" ;;
  version | --version | -v) echo "${VERSION}" ;;
  "" | help | -h | --help) usage ;;
  *) usage >&2; exit 1 ;;
esac
