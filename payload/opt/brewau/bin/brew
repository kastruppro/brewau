#!/bin/bash -p
# brewau wrapper: runs brew as the isolated _brewau account through the
# brew-policy enforcer. Install this directory first in PATH.

BREWAU_ROOT="/opt/brewau"
POLICY="${BREWAU_ROOT}/libexec/brew-policy"

case "${1:-}" in
  shellenv)
    # Same output as Homebrew's shellenv, but keeps this wrapper first in PATH.
    shell="${2:-$(basename "${SHELL:-zsh}")}"
    shell="${shell#-}"
    /opt/homebrew/bin/brew shellenv "${shell}" 2>/dev/null
    npm_default=0 gem_default=0
    if [[ ! ${NPM_CONFIG_PREFIX+x} && ! ${npm_config_prefix+x} ]] &&
      ! /usr/bin/grep -Eq '^[[:space:]]*prefix[[:space:]]*=' "${NPM_CONFIG_USERCONFIG:-${npm_config_userconfig:-${HOME}/.npmrc}}" 2>/dev/null; then
      npm_default=1
    fi
    [[ ${GEM_HOME+x} ]] || gem_default=1
    for variable in NPM_CONFIG_PREFIX GEM_HOME; do
      if [[ "${variable}" == NPM_CONFIG_PREFIX ]]; then
        [[ ${npm_default} == 1 ]] || continue
        value='$HOME/.npm-global'
      else
        [[ ${gem_default} == 1 ]] || continue
        value='$HOME/.gem'
      fi
      case "${shell}" in
        fish) printf 'set -gx %s "%s";\n' "${variable}" "${value}" ;;
        csh | tcsh) printf 'setenv %s "%s";\n' "${variable}" "${value}" ;;
        *) printf 'export %s="%s";\n' "${variable}" "${value}" ;;
      esac
    done
    # Include defaults on subsequent evaluations too, without adding unused dirs.
    dirs='/opt/brewau/bin'
    if [[ ${npm_default} == 1 || "${NPM_CONFIG_PREFIX:-${npm_config_prefix:-}}" == "${HOME}/.npm-global" ]]; then
      dirs+=':$HOME/.npm-global/bin'
    fi
    if [[ ${gem_default} == 1 || "${GEM_HOME:-}" == "${HOME}/.gem" ]]; then
      dirs+=':$HOME/.gem/bin'
    fi
    case "${shell}" in
      zsh)
        echo 'fpath=(/opt/brewau/share/zsh/site-functions ${fpath:#/opt/homebrew/*});'
        printf 'typeset -U path PATH; path=("%s" $path); export PATH;\n' "${dirs//:/\" \"}"
        ;;
      fish) printf 'begin; set -l entries "%s" $PATH; set -gx PATH; for entry in $entries; contains -- "$entry" $PATH; or set -a PATH "$entry"; end; end;\n' "${dirs//:/\" \"}" ;;
      csh | tcsh)
        printf 'set -f path = ("%s" $path:q);\n' "${dirs//:/\" \"}"
        ;;
      *)
        printf 'export PATH="$(printf '\''%%s'\'' "$PATH" | /usr/bin/awk -v first="%s" -v RS=: '\''BEGIN { n=split(first,a,":"); for(i=1;i<=n;i++) if(seen[a[i]]++ == 0) { printf "%%s%%s", sep,a[i]; sep=":" } } seen[$0]++ == 0 { printf ":%%s", $0 }'\'')";\n' "${dirs}"
        ;;
    esac
    exit 0
    ;;
esac

if [[ "$(id -u)" -eq 0 ]]; then
  echo "brewau: do not run brew as root; run it as your normal user." >&2
  exit 1
fi

case " $(id -Gn) " in
  *" brewau_users "*) ;;
  *)
    echo "brewau: $(id -un) is not allowed to use brew on this Mac." >&2
    echo "brewau: an administrator can grant access with: sudo brewau allow-user $(id -un)" >&2
    exit 1
    ;;
esac

# Services run as the user unless they are in ALLOWED_SERVICES; that script
# routes system services through the policy itself.
if [[ "${1:-}" == "services" || ("${1:-}" == "-v" && "${2:-}" == "services") ]]; then
  exec /bin/bash -p "${BREWAU_ROOT}/libexec/brewau-services" "$@"
fi

# _brewau cannot read most users' working directories, and the policy rejects
# paths anyway, so start from / to avoid getcwd errors.
cd / || exit 1
exec /usr/bin/sudo -n -u _brewau -- "${POLICY}" "$@"
