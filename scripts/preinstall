#!/bin/bash
# Installer preinstall: refuse to install where brewau cannot work.

PATH="/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

major="$(/usr/bin/sw_vers -productVersion)"
if [[ "${major%%.*}" -lt 14 ]]; then
  echo "brewau requires macOS 14 or later." >&2
  exit 1
fi

if [[ "$(uname -m)" != "arm64" ]]; then
  echo "brewau requires an Apple Silicon Mac (Homebrew in /opt/homebrew)." >&2
  exit 1
fi

if [[ ! -x /opt/homebrew/bin/brew ]]; then
  echo "Homebrew was not found in /opt/homebrew. Install Homebrew first: https://brew.sh" >&2
  exit 1
fi

# Check before PackageKit replaces the payload. Postinstall takes the same lock for setup.
/usr/bin/env -i PATH="${PATH}" /usr/bin/perl -e '
    use Fcntl qw(:flock O_CREAT O_RDWR O_NOFOLLOW O_NONBLOCK);
    sysopen(my $lock, "/opt/.brewau-setup.lock", O_CREAT | O_RDWR | O_NOFOLLOW | O_NONBLOCK, 0600)
        or die "brewau: could not open the setup lock: $!\n";
    my @st = stat($lock);
    @st && -f _ && $st[3] == 1 && $st[4] == 0 && !($st[2] & 022)
        or die "brewau: invalid setup lock\n";
    flock($lock, LOCK_EX | LOCK_NB) or die "brewau: setup is busy. Try again when it finishes.\n";
    die "brewau: uninstall is in progress. Run sudo brewau uninstall again before reinstalling.\n"
        if -e "/opt/brewau/etc/uninstall-progress";
' || exit 1

# brewau-agent self-update installs this package while it holds the operation
# lock, so no scan or upgrade can be busy; it writes its PID here (root-only).
self_update_running() {
  local pid
  pid="$(/bin/cat /opt/brewau/etc/self-update.pid 2>/dev/null)" || return 1
  [[ "${pid}" =~ ^[0-9]+$ ]] || return 1
  [[ "$(/bin/ps -o comm= -p "${pid}" 2>/dev/null)" == *brewau-agent ]]
}

# Do not replace executables while a worker is using them.
if ! self_update_running; then
  for label in upgrade scan scheduler; do
    if /bin/launchctl print "system/com.kastruppro.brewau.${label}" 2>/dev/null | /usr/bin/grep -q 'state = running'; then
      echo "brewau is working. Wait for the scan or upgrade to finish, then install again." >&2
      exit 1
    fi
  done
fi

exit 0
