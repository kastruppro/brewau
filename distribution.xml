<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>brewau</title>
  <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64"/>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <allowed-os-versions>
    <os-version min="14.0"/>
  </allowed-os-versions>
  <choices-outline>
    <line choice="default">
      <line choice="com.kastruppro.brewau"/>
    </line>
  </choices-outline>
  <choice id="default"/>
  <choice id="com.kastruppro.brewau" visible="false">
    <pkg-ref id="com.kastruppro.brewau"/>
  </choice>
  <pkg-ref id="com.kastruppro.brewau" version="__VERSION__" onConclusion="none">brewau-component.pkg</pkg-ref>
</installer-gui-script>
